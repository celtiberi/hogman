# Locked-down unprivileged sandbox image for Hogman Bot Arena bots and canary servers.
# Built by test-arena/arena.sh using the hogman binary compiled from the repo.
FROM alpine:3.22

RUN apk add --no-cache \
      bash \
      bind-tools \
      ca-certificates \
      coreutils \
      curl \
      grep \
      iputils-ping \
      jq \
      netcat-openbsd \
      openssl \
      python3 \
    && adduser -D -u 1000 -h /home/bot -s /bin/bash bot

COPY hogman /usr/local/bin/hogman
COPY canary_server.py /usr/local/lib/hogman-arena/canary_server.py

RUN chmod 0755 /usr/local/bin/hogman \
    && chmod 0644 /usr/local/lib/hogman-arena/canary_server.py

USER 1000:1000
WORKDIR /home/bot

ENTRYPOINT ["sleep", "infinity"]
