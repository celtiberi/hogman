# The Hogman website: static files plus a first-party cookieless analytics proxy (/e).
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	@www host www.hogman.network
	redir @www https://hogman.network{uri} permanent
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# Everything is served from here. No third-party origins.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'"
		-Server
	}

	handle /e/cfg {
		header Content-Type "application/json; charset=utf-8"
		header Cache-Control "no-store"
		respond `{"token":"{$POSTHOG_KEY:}"}` 200
	}

	handle_path /e/static/* {
		rewrite * /static{path}
		reverse_proxy https://us-assets.i.posthog.com:443 {
			header_up Host us-assets.i.posthog.com
			header_up -Cookie
			header_up -Authorization
			header_down -Access-Control-Allow-Origin
		}
	}

	handle_path /e/array/* {
		rewrite * /array{path}
		reverse_proxy https://us-assets.i.posthog.com:443 {
			header_up Host us-assets.i.posthog.com
			header_up -Cookie
			header_up -Authorization
			header_down -Access-Control-Allow-Origin
		}
	}

	handle_path /e/* {
		@non_bearer {
			not header Authorization "Bearer phc_*"
			not header Authorization "Bearer phs_*"
			not header Authorization "Bearer phx_*"
		}
		request_header @non_bearer -Authorization
		@has_fly_ip header Fly-Client-IP *
		request_header @has_fly_ip X-Forwarded-For {http.request.header.Fly-Client-IP}
		reverse_proxy https://us.i.posthog.com:443 {
			header_up Host us.i.posthog.com
			header_up -Cookie
			header_down -Access-Control-Allow-Origin
		}
	}

	handle {
		root * /srv
		encode zstd gzip
		@assets path *.css *.js *.svg *.webp
		header @assets Cache-Control "public, max-age=3600"
		# The installer and the release pointer must never be stale.
		@fresh path /install.sh /dl/latest /dl/SHA256SUMS
		header @fresh Cache-Control "no-cache"
		@script path /install.sh
		header @script Content-Type "text/plain; charset=utf-8"
		file_server
	}
}
