{
  "manifest_version": 3,
  "name": "Hogman",
  "version": "0.1.0",
  "description": "Routes your Hogman pen sites (*.pens.hogman.network) to your local hogman-join proxy alongside any OS VPN.",
  "icons": {
    "16": "icons/hogman-16.png",
    "32": "icons/hogman-32.png",
    "48": "icons/hogman-48.png",
    "128": "icons/hogman-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "hogman-browser@hogman.network",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "proxy",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "*://*.pens.hogman.network/*",
    "*://pens.hogman.network/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Hogman",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/hogman-16.png",
      "32": "icons/hogman-32.png",
      "48": "icons/hogman-48.png",
      "128": "icons/hogman-128.png"
    }
  }
}
