# What a member puts on their server to host a site. The only network-specific
# lines are the two in the global block.
{
	acme_ca https://ca.{$ZONE}:9000/acme/acme/directory
	acme_ca_root /pki/root_ca.crt
	# The pen carries HTTPS only: prove names over 443 (TLS-ALPN), not 80.
	cert_issuer acme {
		disable_http_challenge
	}
	auto_https disable_redirects
}

alice.{$ZONE} {
	respond "hello from {host}"
}

# Backwards compatibility: a server still pointed at the old port-443 CA URL
# (before step-ca moved onto core-mesh:9000) must still get a certificate.
blog.alice.{$ZONE} {
	tls {
		issuer acme {
			dir https://ca.{$ZONE}/acme/acme/directory
			trusted_roots /pki/root_ca.crt
			disable_http_challenge
		}
	}
	respond "hello from {host}"
}
