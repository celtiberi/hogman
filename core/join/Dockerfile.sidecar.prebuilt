# Multi-arch prebuilt variant of Dockerfile.sidecar for GHCR releases and E2E
# runners that already compiled and attested hogman Linux binaries.
#
# Expected build context files (verified against hogman-SHA256SUMS before build):
#   hogman-linux-amd64   (from hogman-Linux-x86_64)
#   hogman-linux-arm64   (from hogman-Linux-aarch64)
FROM --platform=$BUILDPLATFORM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS prep
ARG TARGETARCH
RUN apk add --no-cache ca-certificates && \
    mkdir -p /rootfs/var/lib/hogman /rootfs/run/hogman-in /rootfs/etc /rootfs/etc/ssl/certs && \
    cp /etc/ssl/certs/ca-certificates.crt /rootfs/etc/ssl/certs/ca-certificates.crt && \
    printf 'nonroot:x:65532:65532:nonroot:/nonexistent:/sbin/nologin\n' > /rootfs/etc/passwd && \
    printf 'nonroot:x:65532:\n' > /rootfs/etc/group && \
    chown 65532:65532 /rootfs/var/lib/hogman /rootfs/run/hogman-in && \
    chmod 0700 /rootfs/var/lib/hogman /rootfs/run/hogman-in
COPY hogman-linux-${TARGETARCH} /rootfs/hogman
RUN chmod 0755 /rootfs/hogman

FROM scratch
ARG VERSION=dev
ARG REVISION=
LABEL org.opencontainers.image.title="hogman-sidecar" \
      org.opencontainers.image.description="Minimal scratch Hogman sidecar and network_mode: none bridge (UID 65532, no shell)" \
      org.opencontainers.image.source="https://github.com/celtiberi/hogman" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"
COPY --from=prep /rootfs/ /
ENV HOGMAN_DISABLE_NETNS=1
USER 65532:65532
ENTRYPOINT ["/hogman"]
