# In-mesh portal at home.<zone>, for a pen with public certificates (D-18).
# Only reachable over the mesh. The registrar gets home.<zone>'s certificate
# from Let's Encrypt (DNS-01) and writes it to /home-tls; Caddy just serves it,
# and the registrar reloads Caddy over the admin socket when it renews.
{
	auto_https off
	admin unix//run/caddy-admin/admin.sock
}

https://home.{$ZONE}:443 {
	tls /home-tls/home.crt /home-tls/home.key
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cache-Control no-store
		Origin-Agent-Cluster ?1
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}
	# Member and admin API, over the Unix socket only the portal and the
	# registrar can see (audit H2). Caddy sets X-Forwarded-For to the caller's
	# mesh address, which is how the registrar knows who is asking.
	handle /api/* {
		reverse_proxy unix//run/hogman-api/mesh.sock
	}
	handle {
		root * /srv/portal
		file_server
	}
}
