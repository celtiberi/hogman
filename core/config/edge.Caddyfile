# Public edge: the network's single public hostname.
# Serves the Headscale control plane, its embedded relay (/derp), and invite
# redemption (/hogman/). Nothing else of the network is reachable from here.
# EDGE_TLS_MODE is empty in production (public cert from Let's Encrypt)
# and "local_certs" for local testing.
{
	{$EDGE_TLS_MODE}
}

http://{$PUBLIC_HOST} {
	# Tailscale captive portal detection
	handle /generate_204 {
		respond 204
	}
	handle {
		redir https://{host}{uri}
	}
}

{$PUBLIC_HOST} {
	# HTTPS only, and browsers remember it for a year.
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	handle /generate_204 {
		respond 204
	}
	handle /start {
		root * /srv/join-page
		rewrite * /start.sh
		header {
			Content-Type "text/plain; charset=utf-8"
			X-Content-Type-Options nosniff
			Cache-Control no-store
		}
		file_server
	}
	# The page an invite link opens, and the join tool downloads.
	handle /join {
		root * /srv/join-page
		rewrite * /index.html
		header {
			X-Frame-Options DENY
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			Cache-Control no-store
			Origin-Agent-Cluster ?1
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
			-Server
		}
		file_server
	}
	handle_path /join/assets/* {
		@asset path /tokens.css /base.css /join.css /join.js /commands.js /hogman-32.png /hogman-48.png /hogman-icon.webp /work-favicon.svg
		handle @asset {
			root * /srv/join-page
			header X-Content-Type-Options nosniff
			file_server
		}
		handle {
			respond 404
		}
	}
	handle_path /join/dl/* {
		root * /srv/join-dl
		header X-Content-Type-Options nosniff
		file_server
	}
	handle /hogman/* {
		header X-Content-Type-Options nosniff
		request_body {
			max_size 16KB
		}
		reverse_proxy registrar:8081
	}
	# Expose only the Tailscale control/relay routes clients need and the
	# health endpoint used by monitoring; keep Headscale's admin REST API,
	# Swagger UI, auth/register pages, and everything else returning 404 (D-19).
	@control path /ts2021 /key /derp /derp/probe /derp/latency-check /bootstrap-dns /machine/ping-response /health
	handle @control {
		reverse_proxy headscale:8080 {
			header_up X-Real-IP {remote_host}
		}
	}
	handle {
		respond 404
	}
}
