# Public edge: the network's single public hostname.
# Serves the Headscale control plane, its embedded relay (/derp), and invite
# redemption (/hogman/). Nothing else of the network is reachable from here.
# EDGE_TLS_MODE is empty in production (public cert from Let's Encrypt)
# and "local_certs" for local testing.
{
	{$EDGE_TLS_MODE}
}

http://{$PUBLIC_HOST} {
	# Tailscale captive portal detection
	handle /generate_204 {
		respond 204
	}
	handle {
		redir https://{host}{uri}
	}
}

{$PUBLIC_HOST} {
	# The page an invite link opens, and the join tool downloads.
	handle /join {
		root * /srv/join-page
		rewrite * /index.html
		header {
			X-Frame-Options DENY
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			Cache-Control no-store
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
			-Server
		}
		file_server
	}
	handle_path /join/assets/* {
		root * /srv/join-page
		header X-Content-Type-Options nosniff
		file_server
	}
	handle_path /join/dl/* {
		root * /srv/join-dl
		file_server
	}
	handle /hogman/* {
		request_body {
			max_size 16KB
		}
		reverse_proxy core-mesh:8081
	}
	# Keep Headscale's admin REST API and Swagger UI off the public edge.
	handle /api/* {
		respond 404
	}
	handle /swagger* {
		respond 404
	}
	handle {
		reverse_proxy headscale:8080 {
			header_up X-Real-IP {remote_host}
		}
	}
}
