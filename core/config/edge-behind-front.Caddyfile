# This pen's edge when it sits behind a shared front door (front-door mode).
# The front door terminates TLS for the pen's public hostname and forwards
# here over the private "hogman-front" network, so this edge speaks plain HTTP.
{
	auto_https off
	servers {
		# Only the front door talks to us; take the visitor's address from it.
		trusted_proxies static private_ranges
	}
}

:80 {
	handle /generate_204 {
		respond 204
	}
	# The page an invite link opens, and the join tool downloads.
	handle /join {
		root * /srv/join-page
		rewrite * /index.html
		header Cache-Control no-store
		file_server
	}
	handle_path /join/dl/* {
		root * /srv/join-dl
		file_server
	}
	handle /hogman/* {
		request_body {
			max_size 16KB
		}
		reverse_proxy core-mesh:8081
	}
	handle {
		reverse_proxy headscale:8080 {
			header_up X-Real-IP {client_ip}
		}
	}
}
