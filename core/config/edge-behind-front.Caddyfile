# This pen's edge when it sits behind a shared front door (front-door mode).
# The front door terminates TLS for the pen's public hostname and forwards
# here over the private "hogman-front" network, so this edge speaks plain HTTP.
{
	auto_https off
	servers {
		# Only the front door talks to us; take the visitor's address from it.
		trusted_proxies static private_ranges
	}
}

http://{$PUBLIC_HOST} {
	handle /generate_204 {
		respond 204
	}
	# The page an invite link opens, and the join tool downloads.
	handle /join {
		root * /srv/join-page
		rewrite * /index.html
		header {
			X-Frame-Options DENY
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			Cache-Control no-store
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
			-Server
		}
		file_server
	}
	handle_path /join/assets/* {
		root * /srv/join-page
		header X-Content-Type-Options nosniff
		file_server
	}
	handle_path /join/dl/* {
		root * /srv/join-dl
		file_server
	}
	handle /hogman/* {
		request_body {
			max_size 16KB
		}
		reverse_proxy core-mesh:8081
	}
	# Keep Headscale's admin REST API and Swagger UI off the public edge.
	handle /api/* {
		respond 404
	}
	handle /swagger* {
		respond 404
	}
	handle {
		reverse_proxy headscale:8080 {
			header_up X-Real-IP {client_ip}
		}
	}
}
