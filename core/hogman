#!/usr/bin/env bash
# hogman: deploy and operate one Hogman network (the core node).
#
# Setup commands live here. Everything about members, invites, devices and
# names is passed through to the registrar, which is the source of truth.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
cd "$HERE"

DATA="$HERE/data"
STATE="$DATA/state.env"

die()  { echo "hogman: $*" >&2; exit 1; }
info() { echo "==> $*" >&2; }

usage() {
  cat <<'EOF'
usage: hogman <command> [args]

Setup
  init                         Initialise the network's folders and configs (once)
  up                           Bootstrap on first run, then start everything
  down                         Stop everything
  status                       Containers, members and devices
  logs [service]               Follow logs

Members (run by the owner on this server; see `hogman help-registrar`)
  member add <handle> --role owner     Create the owner (first thing after `up`)
  member list | suspend | resume | kick | role
  invite create | list | revoke
  device key <handle> personal|server  | device list | device rm <id>
  name list | claim | release
  audit [count]

Other
  headscale <args...>          Run the Headscale CLI directly
EOF
}

# ---------------------------------------------------------------- config ----

valid_host() {
  local h="$1"
  [ -n "$h" ] && [ "${#h}" -le 253 ] || return 1
  [[ "$h" != *$'\n'* ]] && [[ "$h" != *$'\r'* ]] || return 1
  [[ "$h" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$ ]]
}

valid_ipv4() {
  local ip="$1" o
  [[ "$ip" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  for o in "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"; do
    [[ "$o" =~ ^0[0-9] ]] && return 1
    [ "$o" -le 255 ] || return 1
  done
}

load_env() {
  [ -f .env ] || die "no .env. Copy .env.example to .env and edit it."
  set -a
  # shellcheck disable=SC1091
  . ./.env
  [ -f "$STATE" ] && . "$STATE"
  set +a
  : "${NETWORK:?set NETWORK in .env}"
  : "${PUBLIC_HOST:?set PUBLIC_HOST in .env}"
  : "${ZONE:?set ZONE in .env, e.g. ${NETWORK}.pens.hogman.network}"
  case "$NETWORK" in
    *[!a-z0-9-]*|-*|*-) die "NETWORK must be lowercase letters, digits and dashes" ;;
  esac
  valid_host "$PUBLIC_HOST" || die "PUBLIC_HOST must be a valid DNS hostname"
  valid_host "$ZONE" || die "ZONE must be a valid DNS name"
  case "$ZONE" in "$NETWORK".*) ;; *) die "ZONE must start with the pen's name: $NETWORK.<domain>" ;; esac
  export ZONE
  if [ -n "${PUBLIC_IPV4:-}" ]; then
    valid_ipv4 "$PUBLIC_IPV4" || die "PUBLIC_IPV4 must be a valid IPv4 address"
  fi
  export STUN_PORT="${STUN_PORT:-3478}"
  # FRONT_DOOR=true: this pen sits behind a shared front door (deploy/hogman-host)
  # that holds ports 80/443 and the public certificate for every pen on the host.
  export FRONT_DOOR="${FRONT_DOOR:-false}"
  export TEST_MODE="${TEST_MODE:-false}"
  if [ "$TEST_MODE" = true ]; then
    export EDGE_TLS_MODE="local_certs"
  else
    export EDGE_TLS_MODE=""
  fi
}

dc() {
  local args=(--env-file .env)
  [ -f "$STATE" ] && args+=(--env-file "$STATE")
  local files=(-f compose.yaml)
  [ "$FRONT_DOOR" = true ] && files+=(-f compose.front.yaml)
  [ "$TEST_MODE" = true ] && [ "$FRONT_DOOR" != true ] && [ -f test/compose.test.yaml ] && files+=(-f test/compose.test.yaml)
  [ "$TEST_MODE" = true ] && [ -n "${HOGMAN_TEST_ACME_ROOT:-}" ] && files+=(-f test/compose.acme-root.yaml)
  ZONE="$ZONE" EDGE_TLS_MODE="$EDGE_TLS_MODE" docker compose -p "${COMPOSE_PROJECT_NAME:-hogman}" \
    "${args[@]}" "${files[@]}" "$@"
}

hs()  { dc exec -T headscale headscale "$@"; }
reg() { dc exec -T registrar registrar "$@"; }

set_state() {   # set_state KEY VALUE
  touch "$STATE"
  grep -v "^$1=" "$STATE" > "$STATE.tmp" || true
  echo "$1=$2" >> "$STATE.tmp"
  mv "$STATE.tmp" "$STATE"
  export "$1=$2"
}

unset_state() { # unset_state KEY
  if [ -f "$STATE" ]; then
    grep -v "^$1=" "$STATE" > "$STATE.tmp" || true
    mv "$STATE.tmp" "$STATE"
  fi
  unset "$1" || true
}

# Replace @@NAME@@ with the value of environment variable NAME.
render() {
  awk '{
    while (match($0, /@@[A-Z0-9_]+@@/)) {
      name = substr($0, RSTART + 2, RLENGTH - 4)
      $0 = substr($0, 1, RSTART - 1) ENVIRON[name] substr($0, RSTART + RLENGTH)
    }
    print
  }' "$1" > "$2"
}

wait_for() {    # wait_for <description> <seconds> <command...>
  local what="$1" tries="$2"; shift 2
  for _ in $(seq "$tries"); do
    if "$@" >/dev/null 2>&1; then return 0; fi
    sleep 1
  done
  case "$what" in
    headscale)                dc logs --tail 30 headscale >&2 2>&1 || true ;;
    registrar*|"core mesh IP") dc logs --tail 40 registrar >&2 2>&1 || true ;;
  esac
  die "timed out waiting for $what"
}

json_field() {  # json_field <field>  (reads one JSON object on stdin)
  sed -n "s/.*\"$1\": *\"\([^\"]*\)\".*/\1/p" | head -1
}

randpw() { head -c 32 /dev/urandom | base64 | tr -d '/+=\n' | head -c 40; }

# The user the registrar runs as. Never root (audit H3): run by a
# person, that's them. Run as root (a hosted server, or the sign-up broker's
# container), it's a fixed numeric user with no account, 65532 ("nonroot" by
# the usual convention), so it's the same everywhere and survives rebuilds.
run_ids() {   # prints "UID GID"
  if [ "$(id -u)" != 0 ]; then echo "$(id -u) $(id -g)"; return; fi
  echo "${HOGMAN_PEN_UID:-65532} ${HOGMAN_PEN_GID:-65532}"
}

# Hand the runtime user what it reads and writes. When running as root (hosted
# servers), chown directly. When a non-root docker-group operator upgrades an
# older self-hosted pen whose headscale/lib was previously written as root, do a
# one-time ownership migration via an already-pulled Alpine/Caddy image so
# non-root headscale can read its keys and database.
own_runtime_files() {
  chmod 755 "$DATA/join-dl" 2>/dev/null || true
  chmod -R a+rX "$DATA/join-dl" "$DATA/headscale/config" "$DATA/edge-trust" 2>/dev/null || true
  [ -n "${HOGMAN_UID:-}" ] && [ "$HOGMAN_UID" != 0 ] || return 0
  if [ "$(id -u)" = 0 ]; then
    local d
    for d in "$DATA/headscale/lib" "$DATA/registrar" "$DATA/edge" "$DATA/secrets/registrar" "$DATA/home-tls"; do
      [ -e "$d" ] && chown -R "$HOGMAN_UID:$HOGMAN_GID" "$d"
    done
    return 0
  fi
  if [ -d "$DATA/headscale/lib" ] && [ -n "$(find "$DATA/headscale/lib" ! -user "$HOGMAN_UID" -print -quit 2>/dev/null)" ]; then
    local helper_img=""
    if [ -f registrar/Dockerfile.prebuilt ]; then
      helper_img="$(awk '/^FROM[[:space:]]+alpine:/ {print $2; exit}' registrar/Dockerfile.prebuilt)"
    fi
    if [ -z "$helper_img" ]; then
      helper_img="$(awk '/^[[:space:]]*image:[[:space:]]*caddy:/ {print $2; exit}' compose.yaml)"
    fi
    [ -n "$helper_img" ] || die "cannot migrate $DATA/headscale/lib ownership automatically; run: sudo chown -R $HOGMAN_UID:$HOGMAN_GID $DATA/headscale/lib"
    docker run --rm --user 0:0 --entrypoint /bin/chown \
      -v "$DATA/headscale/lib:/hslib" "$helper_img" \
      -R "$HOGMAN_UID:$HOGMAN_GID" /hslib \
      || die "could not migrate $DATA/headscale/lib ownership for non-root headscale; run: sudo chown -R $HOGMAN_UID:$HOGMAN_GID $DATA/headscale/lib"
  fi
  return 0
}

# ------------------------------------------------------------------ init ----

# A pen with public certificates (D-18 / D-22): no certificate authority,
# nothing for members to install, and no root key to look after.
cmd_init() {
  load_env
  [ -n "${INITIALISED:-}" ] && die "already initialised ($INITIALISED)."
  info "Network $NETWORK, zone $ZONE, control host $PUBLIC_HOST (public certificates)"
  mkdir -p "$DATA"/{headscale/config,headscale/lib,registrar/tsnet} \
           "$DATA"/{edge,edge-trust,secrets/registrar,join-dl,tmp,home-tls}
  chmod 700 "$DATA/secrets/registrar" "$DATA/registrar" "$DATA/registrar/tsnet" "$DATA/headscale/lib" \
            "$DATA/home-tls"
  local ids; ids="$(run_ids)"
  HOGMAN_UID="${ids% *}"; HOGMAN_GID="${ids#* }"
  set_state HOGMAN_UID "$HOGMAN_UID"
  set_state HOGMAN_GID "$HOGMAN_GID"
  render templates/policy.hujson "$DATA/headscale/config/policy.hujson"
  set_state INITIALISED public
  own_runtime_files
  cat >&2 <<EOF

Initialised, with public certificates: there's no certificate authority and
nothing for members to install. home.$ZONE gets its certificate from Let's
Encrypt when the pen starts, through the host's challenge DNS server.

Next: put this pen's challenge DNS token in data/secrets/registrar/challenge_dns_token
(hogman-host does this for you), then ./hogman up
EOF
}

# -------------------------------------------------------------------- up ----

render_headscale() {
  if [ -n "${CORE_MESH_IP:-}" ]; then
    SPLIT_DNS="      \"$ZONE\":
        - $CORE_MESH_IP"
  else
    SPLIT_DNS="      {}"
  fi
  if [ -n "${PUBLIC_IPV4:-}" ]; then
    DERP_IPV4_LINE="    ipv4: $PUBLIC_IPV4"
  else
    DERP_IPV4_LINE=""
  fi
  export SPLIT_DNS DERP_IPV4_LINE
  render templates/headscale.yaml "$DATA/headscale/config/config.yaml"
}

infra_key() {
  hs preauthkeys create --tags tag:infra --expiration 15m --output json | json_field key
}

registrar_mesh_ip() {
  [ -s "$DATA/registrar/tsnet/mesh-ip" ] && tr -d '\r\n' < "$DATA/registrar/tsnet/mesh-ip"
}
has_registrar_mesh_ip() { [ -n "$(registrar_mesh_ip)" ]; }

# Ensure any legacy core-mesh container for this compose project is completely
# stopped and removed before copying tailscaled.state into registrar/tsnet
# (never run both nodes with the same key simultaneously).
stop_legacy_core_mesh() {
  local proj="${COMPOSE_PROJECT_NAME:-hogman}" cid
  cid="$(docker ps -aq --filter "label=com.docker.compose.project=$proj" --filter "label=com.docker.compose.service=core-mesh" 2>/dev/null || true)"
  if [ -n "$cid" ]; then
    docker rm -f $cid >/dev/null 2>&1 || true
  fi
  cid="$(docker ps -q --filter "label=com.docker.compose.project=$proj" --filter "label=com.docker.compose.service=core-mesh" 2>/dev/null || true)"
  [ -z "$cid" ] || die "legacy core-mesh container is still running; refusing to start registrar with copied state"
}

migrate_legacy_tailscale_state() {
  # Copy (never move) legacy data/mesh/core/tailscaled.state into data/registrar/tsnet/
  # so the pen preserves its exact Headscale node ID and CORE_MESH_IP, and keeps
  # data/mesh/core/ intact for rollback.
  if [ -f "$DATA/mesh/core/tailscaled.state" ] && [ ! -f "$DATA/registrar/tsnet/tailscaled.state" ]; then
    stop_legacy_core_mesh
    mkdir -p "$DATA/registrar/tsnet"
    chmod 700 "$DATA/registrar/tsnet"
    ( umask 077; cp "$DATA/mesh/core/tailscaled.state" "$DATA/registrar/tsnet/tailscaled.state" )
    chmod 600 "$DATA/registrar/tsnet/tailscaled.state"
    own_runtime_files
  fi
}

# Releases ship the join tool and the registrar already compiled (prebuilt/,
# checked by install.sh against the release's checksums), so a small server
# does not spend half an hour compiling. Without prebuilt/, build from source.
use_prebuilt_or_build() {
  if [ -f prebuilt/join/SHA256SUMS ]; then
    info "Using the prebuilt join tool from this release"
    mkdir -p "$DATA/join-dl"
    rm -f "$DATA/join-dl"/hogman-join-*
    cp prebuilt/join/* "$DATA/join-dl/"
  elif [ -n "${FRONT_JOIN_DL:-}" ] && [ -f "$FRONT_JOIN_DL/SHA256SUMS" ]; then
    info "Using the join tool built for the front door"
    mkdir -p "$DATA/join-dl"
    rm -f "$DATA/join-dl"/hogman-join-*
    cp "$FRONT_JOIN_DL"/* "$DATA/join-dl/"
  else
    info "Building the join tool for download"
    mkdir -p "$DATA/join-dl"
    rm -f "$DATA/join-dl"/hogman-join-*
    docker build -q --output "type=local,dest=$DATA/join-dl" join >/dev/null
  fi
  chmod 755 "$DATA/join-dl" 2>/dev/null || true
  chmod -R a+rX "$DATA/join-dl" 2>/dev/null || true
  local arch
  case "$(uname -m)" in x86_64|amd64) arch=amd64 ;; aarch64|arm64) arch=arm64 ;; *) arch="" ;; esac
  if [ -n "$arch" ] && [ -f "prebuilt/registrar/registrar-linux-$arch" ]; then
    info "Using the prebuilt registrar from this release"
    install -m 0755 "prebuilt/registrar/registrar-linux-$arch" registrar/registrar.bin
    export REGISTRAR_DOCKERFILE=Dockerfile.prebuilt
  else
    export REGISTRAR_DOCKERFILE=Dockerfile
  fi
}

cmd_up() {
  load_env
  [ -n "${INITIALISED:-}" ] || die "run ./hogman init first."
  [ -s "$DATA/secrets/registrar/challenge_dns_token" ] \
    || die "no challenge DNS token in data/secrets/registrar/challenge_dns_token (hogman-host adds it)"
  mkdir -p "$DATA"/{edge,edge-trust,join-dl,tmp,home-tls,registrar/tsnet}
  chmod 700 "$DATA/edge" "$DATA/home-tls" "$DATA/registrar" "$DATA/registrar/tsnet"
  # Pens raised as root before audit H3 ran the registrar as root too. Move it
  # to the unprivileged user on the next start.
  if [ "${HOGMAN_UID:-}" = 0 ] && [ "$(id -u)" = 0 ]; then
    local ids; ids="$(run_ids)"
    HOGMAN_UID="${ids% *}"; HOGMAN_GID="${ids#* }"
    set_state HOGMAN_UID "$HOGMAN_UID"
    set_state HOGMAN_GID "$HOGMAN_GID"
    info "registrar now runs as user $HOGMAN_UID, not root"
  fi
  if [ "$(id -u)" = 0 ] && [ -n "${HOGMAN_UID:-}" ] && [ "$HOGMAN_UID" != 0 ]; then
    local svc cid cur
    for svc in headscale registrar edge; do
      cid="$(dc ps -q "$svc" 2>/dev/null || true)"
      [ -n "$cid" ] || continue
      cur="$(docker inspect -f '{{.Config.User}}' "$cid" 2>/dev/null || true)"
      if [ "$cur" != "$HOGMAN_UID:$HOGMAN_GID" ]; then
        dc stop "$svc" >/dev/null 2>&1 || true
      fi
    done
  fi
  own_runtime_files
  use_prebuilt_or_build

  if [ -z "${CORE_MESH_IP:-}" ]; then
    info "First start: bootstrapping"
    render_headscale
    if [ "$FRONT_DOOR" = true ]; then
      dc up -d headscale
    else
      dc up -d headscale edge
    fi
    wait_for "headscale" 60 hs health

    # Default-deny from the first moment: nothing but the core may talk.
    hs policy set --file /etc/headscale/policy.hujson >/dev/null

    if [ "$TEST_MODE" = true ]; then
      # The control host's test certificate comes from whoever terminates TLS:
      # this pen's edge, or the shared front door (FRONT_CA points at its root).
      local root="${FRONT_CA:-$DATA/edge/caddy/pki/authorities/local/root.crt}"
      wait_for "edge test certificate" 60 test -s "$root"
      cp "$root" "$DATA/edge-trust/root.crt"
      chmod 644 "$DATA/edge-trust/root.crt"
    fi

    info "Creating the registrar's Headscale API key"
    (
      umask 077
      hs apikeys create --expiration 3650d | tail -1 | tr -d '\r\n' > "$DATA/secrets/registrar/headscale_api_key"
    )
    chmod 600 "$DATA/secrets/registrar/headscale_api_key"

    info "Joining the registrar's embedded core node to the mesh"
    rm -f "$DATA/registrar/tsnet/mesh-ip"
    (
      umask 077
      printf '%s\n' "$(infra_key)" > "$DATA/registrar/tsnet/.authkey"
    )
    chmod 600 "$DATA/registrar/tsnet/.authkey"
    own_runtime_files

    dc up -d --build registrar
    wait_for "core mesh IP" 90 has_registrar_mesh_ip
    set_state CORE_MESH_IP "$(registrar_mesh_ip)"
    rm -f "$DATA/registrar/tsnet/.authkey"
    info "core = $CORE_MESH_IP"

    render_headscale
    dc restart headscale
    wait_for "headscale" 60 hs health
  else
    migrate_legacy_tailscale_state
    render_headscale
  fi

  if [ "$FRONT_DOOR" = true ]; then
    # Upgraded pens from before the front door took over edge's job may still
    # have an edge container; profiled services are not removed as orphans.
    dc --profile standalone rm -sf edge >/dev/null 2>&1 || true
  fi
  stop_legacy_core_mesh
  dc up -d --build --remove-orphans
  local wait_secs="${REGISTRAR_WAIT_SECS:-90}"
  wait_for "registrar" "$wait_secs" reg sync
  wait_for "registrar health" "$wait_secs" reg health
  if [ -d "$DATA/coredns" ]; then
    rm -rf "$DATA/coredns"
  fi
  info "Up. Control server: https://$PUBLIC_HOST   Portal (on the mesh): https://home.$ZONE"
  if ! reg member list 2>/dev/null | awk 'NR>1 && $3=="owner" {found=1} END {exit !found}'; then
    info "Next: create yourself as owner:  ./hogman member add <handle> --role owner"
    info "      then join your device:      ./hogman device key <handle> personal"
  fi
}

# ------------------------------------------------------------------- main ----

main() {
  local cmd="${1:-}"; [ $# -gt 0 ] && shift
  case "$cmd" in
    init)      cmd_init ;;
    up)        cmd_up ;;
    down)      load_env
               if [ "$FRONT_DOOR" = true ]; then
                 dc --profile standalone down "$@"
               elif [ "$TEST_MODE" = true ]; then
                 dc --profile clients down "$@"
               else
                 dc down "$@"
               fi ;;
    status)    load_env; dc ps; echo; reg member list; echo; reg device list ;;
    logs)      load_env; dc logs -f "$@" ;;
    member|invite|device|name|audit|sync|health)
               load_env; reg "$cmd" "$@" ;;
    help-registrar) load_env; reg help ;;
    headscale) load_env; hs "$@" ;;
    ""|-h|--help|help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
