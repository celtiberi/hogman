# Copy to .env and edit.

# Your network's name. Members' sites live under <name>.hogman,
# e.g. NETWORK=bobo gives alice.bobo.hogman.
NETWORK=bobo

# The one public hostname for this server (DESIGN.md section 4).
# Point its DNS A record at this server. Members never type it.
PUBLIC_HOST=hs.example.com

# This server's public IPv4 address. Improves relay reliability.
PUBLIC_IPV4=

# true only for local testing: the public hostname gets a self-signed cert.
TEST_MODE=false
