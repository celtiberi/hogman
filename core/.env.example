# Copy to .env and edit.

# Your network's name and zone. Members' sites live under <name>.<zone>,
# e.g. ZONE=bobo.pens.example.com gives alice.bobo.pens.example.com.
NETWORK=bobo
ZONE=bobo.pens.example.com

# The one public hostname for this server.
# Point its DNS A record at this server. Members never type it.
PUBLIC_HOST=bobo.gate.example.com

# This server's public IPv4 address. Improves relay reliability.
PUBLIC_IPV4=

# true only for local testing: the public hostname gets a self-signed cert.
TEST_MODE=false
