# Used when a release ships hogman-signup compiled (hogman-host copies it to
# hogman-signup.bin first).
FROM alpine:3.24 AS certs
RUN apk add --no-cache ca-certificates

FROM scratch AS web
# Root certificates: the page talks to Stripe's API over HTTPS when it sells pens.
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY hogman-signup.bin /hogman-signup
USER 65534:65534
ENV ROLE=web
ENTRYPOINT ["/hogman-signup"]

FROM alpine:3.24 AS broker
RUN apk add --no-cache bash coreutils findutils grep sed gawk tar gzip rsync age openssl curl util-linux \
      ca-certificates docker-cli docker-cli-compose docker-cli-buildx
COPY hogman-signup.bin /usr/local/bin/hogman-signup
ENV ROLE=broker
ENTRYPOINT ["hogman-signup"]
