Description=Hogman: daily pen lifecycle sweep (D-35 grace, sleep, delete)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
Environment=HOGMAN_HOME=$HOGMAN_HOME
ExecStart=/usr/local/bin/hogman-host lifecycle
UNIT
  cat > /etc/systemd/system/hogman-lifecycle.timer <<'UNIT'
