# ---------------------------------------------------------------- backup ----
#
# Each pen's essential state, encrypted for a key the server never holds the
# private half of. Another machine downloads the encrypted files through a
# dedicated account that can list and fetch backups and do nothing else.

BACKUPS="${HOGMAN_BACKUPS:-/var/backups/hogman}"
RECIPIENT="$HOGMAN_HOME/backup-recipient.txt"
SERVE=/usr/local/lib/hogman/backup-serve
KEEP_LOCAL=7
BACKUP_RETENTION_DAYS=30

parse_backup_utc_epoch() {
  local raw="${1:-}" iso=""
  [ -n "$raw" ] || return 1
  if [[ "$raw" =~ ^([0-9]{4})([0-9]{2})([0-9]{2})T([0-9]{2})([0-9]{2})([0-9]{2})Z$ ]]; then
    iso="${BASH_REMATCH[1]}-${BASH_REMATCH[2]}-${BASH_REMATCH[3]}T${BASH_REMATCH[4]}:${BASH_REMATCH[5]}:${BASH_REMATCH[6]}Z"
  else
    iso="$(printf '%s' "$raw" | sed -E 's/\.[0-9]+Z$/Z/')"
  fi
  date -u -d "$iso" +%s 2>/dev/null \
    || date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$iso" +%s 2>/dev/null \
    || return 1
}

# Remove backups of deleted pens once 30 days have passed since deletion (D-37):
# - Retired pens under $PENS/<pen>/.retired count from deleted_at= in .retired
#   (or newest backup timestamp if .retired predates D-37).
# - Legacy deleted pens whose folder no longer exists under $PENS/ count from
#   each backup filename's own UTC timestamp.
# Uses the exact -YYYYMMDDTHHMMSSZ.tar.gz.age suffix match so pen "foo" never
# touches "foo-bar"'s files, and never touches host "challenge-dns" backups.
prune_deleted_pen_backups() {
  local dry_run="${1:-0}"
  [ -d "$BACKUPS" ] || return 0
  local now_epoch="${BACKUP_NOW_EPOCH:-$(date -u +%s)}"
  local retention_sec=$((BACKUP_RETENTION_DAYS * 86400))

  # 1. Retired pens still represented by $PENS/<pen>/.retired
  local pen_dir n del_raw del_epoch f ts ts_epoch count
  if [ -d "$PENS" ]; then
    while IFS= read -r pen_dir; do
      [ -d "$pen_dir" ] || continue
      [ -f "$pen_dir/.retired" ] || continue
      n="$(basename "$pen_dir")"
      valid_name "$n" || continue

      del_raw="$(awk -F= '$1 == "deleted_at" { print $2; exit }' "$pen_dir/.retired" 2>/dev/null | tr -d '\r\n' || true)"
      del_epoch=""
      if [ -n "$del_raw" ]; then
        del_epoch="$(parse_backup_utc_epoch "$del_raw" || true)"
      fi

      local files=()
      for f in "$BACKUPS/$n"-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z.tar.gz.age; do
        [ -f "$f" ] || continue
        files+=("$f")
      done
      [ "${#files[@]}" -gt 0 ] || continue

      if [ -z "$del_epoch" ]; then
        # Pre-D-37 empty .retired marker: fall back to the newest backup's own timestamp.
        for f in "${files[@]}"; do
          ts="${f%.tar.gz.age}"; ts="${ts##*-}"
          ts_epoch="$(parse_backup_utc_epoch "$ts" || true)"
          if [ -n "$ts_epoch" ] && { [ -z "$del_epoch" ] || [ "$ts_epoch" -gt "$del_epoch" ]; }; then
            del_epoch="$ts_epoch"
          fi
        done
      fi
      [ -n "$del_epoch" ] || continue

      if [ $((now_epoch - del_epoch)) -ge "$retention_sec" ]; then
        count="${#files[@]}"
        if [ "$dry_run" = 1 ]; then
          info "[dry-run] would prune $count expired backup(s) for deleted pen $n (D-37)"
        else
          rm -f -- "${files[@]}"
          info "pruned $count expired backup(s) for deleted pen $n (D-37)"
        fi
      fi
    done < <(find "$PENS" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort)
  fi

  # 2. Orphan backups whose pen directory no longer exists under $PENS/
  local base pen
  local orphan_pens=""
  for f in "$BACKUPS"/*-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z.tar.gz.age; do
    [ -f "$f" ] || continue
    base="$(basename "$f")"
    [[ "$base" =~ ^([a-z0-9-]+)-([0-9]{8}T[0-9]{6}Z)\.tar\.gz\.age$ ]] || continue
    pen="${BASH_REMATCH[1]}"
    [ "$pen" = "challenge-dns" ] && continue
    [ -d "$PENS/$pen" ] && continue
    orphan_pens+="$pen"$'\n'
  done
  [ -n "$orphan_pens" ] || return 0

  while IFS= read -r pen; do
    [ -n "$pen" ] || continue
    local expired=()
    for f in "$BACKUPS/$pen"-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z.tar.gz.age; do
      [ -f "$f" ] || continue
      ts="${f%.tar.gz.age}"; ts="${ts##*-}"
      ts_epoch="$(parse_backup_utc_epoch "$ts" || true)"
      [ -n "$ts_epoch" ] || continue
      if [ $((now_epoch - ts_epoch)) -ge "$retention_sec" ]; then
        expired+=("$f")
      fi
    done
    [ "${#expired[@]}" -gt 0 ] || continue
    count="${#expired[@]}"
    if [ "$dry_run" = 1 ]; then
      info "[dry-run] would prune $count expired backup(s) for removed pen $pen (D-37)"
    else
      rm -f -- "${expired[@]}"
      info "pruned $count expired backup(s) for removed pen $pen (D-37)"
    fi
  done < <(printf '%s' "$orphan_pens" | sort -u)
}

cmd_backup_prune() {
  local dry_run=0
  case "${1:-}" in
    "") ;;
    --dry-run) dry_run=1 ;;
    *) die "usage: hogman-host backup-prune [--dry-run]" ;;
  esac
  prune_deleted_pen_backups "$dry_run"
}

cmd_backup_setup() {
  local key="${1:-}"
  [[ "$key" =~ ^age1[0-9a-z]{58}$ ]] || die "usage: hogman-host backup-setup <age public key, age1...>"
  command -v age >/dev/null || { apt-get install -yq age >/dev/null || die "could not install age"; }
  echo "$key" > "$RECIPIENT"
  id hogman-backup >/dev/null 2>&1 || useradd --system --home-dir /var/lib/hogman-backup --create-home --shell /bin/sh hogman-backup
  passwd -l hogman-backup >/dev/null 2>&1 || true
  install -d -m 0750 -o root -g hogman-backup "$BACKUPS"
  install -d -m 0755 /usr/local/lib/hogman
  cat > "$SERVE" <<'SERVE'
#!/bin/sh
# Forced command for the hogman-backup account: list or fetch one backup file.
set -eu
set -f
dir=/var/backups/hogman
set -- ${SSH_ORIGINAL_COMMAND:-}
case "${1:-}" in
  list) cd "$dir" && ls -1 -- *.tar.gz.age 2>/dev/null || true ;;
  get)
    name="${2:-}"
    printf '%s' "$name" | grep -Eq '^[a-z0-9-]+-[0-9]{8}T[0-9]{6}Z\.tar\.gz\.age$' || { echo "bad name" >&2; exit 2; }
    [ -f "$dir/$name" ] || { echo "no such backup" >&2; exit 3; }
    cat "$dir/$name" ;;
  *) echo "only: list | get <name>" >&2; exit 2 ;;
esac
SERVE
  chmod 0755 "$SERVE"
  cat > /etc/systemd/system/hogman-backup.service <<UNIT
[Unit]
Description=Hogman: encrypted backup of every pen
[Service]
Type=oneshot
Environment=HOGMAN_HOME=$HOGMAN_HOME
ExecStart=/usr/local/bin/hogman-host backup
UNIT
  cat > /etc/systemd/system/hogman-backup.timer <<'UNIT'
[Unit]
Description=Hogman: nightly encrypted backup
[Timer]
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=10m
Persistent=true
[Install]
WantedBy=timers.target
UNIT
  systemctl daemon-reload
  systemctl enable --now hogman-backup.timer >/dev/null
  info "Nightly backups on (03:30 UTC), encrypted for $key"
  info "Let a machine download them:  hogman-host backup-allow '<its ssh public key>'"
}

cmd_backup_allow() {
  local pub="${1:-}"
  # Reject newlines/CR/control chars so a multiline comment cannot inject an
  # unrestricted second line into authorized_keys.
  [[ "$pub" != *$'\n'* && "$pub" != *$'\r'* ]] \
    && [[ "$pub" =~ ^(ssh-ed25519|ecdsa-sha2-nistp256|ssh-rsa)\ [A-Za-z0-9+/=]+(\ [!-~]+(\ [!-~]+)*)?$ ]] \
    && [[ "$pub" != *\"* ]] \
    || die "usage: hogman-host backup-allow '<ssh public key>'"
  id hogman-backup >/dev/null 2>&1 || die "run hogman-host backup-setup first"
  local home; home="$(getent passwd hogman-backup | cut -d: -f6)"
  install -d -m 0750 -o root -g hogman-backup "$home/.ssh"
  local line="command=\"$SERVE\",restrict $pub"
  touch "$home/.ssh/authorized_keys"
  grep -qxF "$line" "$home/.ssh/authorized_keys" || echo "$line" >> "$home/.ssh/authorized_keys"
  chown root:hogman-backup "$home/.ssh/authorized_keys"; chmod 0640 "$home/.ssh/authorized_keys"
  info "That key can now list and download encrypted backups as hogman-backup@$(hostname), and nothing else."
}

backup_pen() {  # backup_pen <name>
  local n="$1" pen="$PENS/$1" stage ts out
  stage="$(mktemp -d)"
  # Everything needed to bring the pen back, minus what returns by itself:
  # the compiled join tool (every release ships it) and edge/portal runtime state.
  rsync -a "$pen/data/" "$stage/data/" \
    --exclude join-dl/ --exclude edge/ --exclude portal/ --exclude tmp/ --exclude api/ \
    --exclude 'headscale/lib/db.sqlite*' --exclude 'registrar/registrar.db*'
  # Databases are copied with SQLite's own backup, safe while the pen runs.
  sqlite3 "$pen/data/headscale/lib/db.sqlite" ".backup '$stage/data/headscale/lib/db.sqlite'"
  sqlite3 "$pen/data/registrar/registrar.db" ".backup '$stage/data/registrar/registrar.db'"
  cp "$pen/.env" "$stage/.env"
  cat "$HOGMAN_HOME/VERSION" > "$stage/VERSION" 2>/dev/null || true
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  out="$BACKUPS/$n-$ts.tar.gz.age"
  tar -C "$stage" -czf - . | age -r "$(cat "$RECIPIENT")" > "$out.part"
  rm -rf "$stage"
  local bgrp=hogman-backup
  if ! getent group "$bgrp" >/dev/null 2>&1; then
    bgrp="$(stat -c '%g' "$BACKUPS" 2>/dev/null || stat -f '%g' "$BACKUPS" 2>/dev/null || echo 0)"
  fi
  chown "0:$bgrp" "$out.part" 2>/dev/null || true; chmod 0640 "$out.part"; mv "$out.part" "$out"
  # Keep the newest few here; anchor to the exact timestamp suffix so pen "foo"
  # never matches and prunes backups of "foo-bar".
  ls -1t "$BACKUPS/$n"-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z.tar.gz.age 2>/dev/null \
    | tail -n +$((KEEP_LOCAL + 1)) | xargs -r rm -f
  info "$n: $(basename "$out") ($(du -h "$out" | cut -f1))"
}

cmd_backup() {
  [ -f "$RECIPIENT" ] || die "run hogman-host backup-setup <age public key> first"
  local n ok=0
  for n in $(pen_names); do
    [ -f "$PENS/$n/.removed" ] && continue
    backup_pen "$n"; ok=$((ok + 1))
  done
  [ "$ok" -gt 0 ] || info "no pens to back up"
  # The challenge DNS server's state: credential hashes and the pen names ever
  # used (D-21), so a rebuilt host can't hand a used name out again.
  if [ -f "$CDNS_STATE" ]; then
    local ts out; ts="$(date -u +%Y%m%dT%H%M%SZ)"; out="$BACKUPS/challenge-dns-$ts.tar.gz.age"
    tar -C "$(dirname "$CDNS_STATE")" -czf - "$(basename "$CDNS_STATE")" | age -r "$(cat "$RECIPIENT")" > "$out.part" \
      && chown root:hogman-backup "$out.part" && chmod 0640 "$out.part" && mv "$out.part" "$out"
    ls -1t "$BACKUPS"/challenge-dns-[0-9]*.tar.gz.age 2>/dev/null | tail -n +$((KEEP_LOCAL + 1)) | xargs -r rm -f
  fi
}

# --------------------------------------------------------------- hosting ----
# Pens raised for other people from the sign-up page. The page's broker runs
# `provision`; a person runs the rest.

SIGNUP="$HOGMAN_HOME/signup"
HOSTED_RE='^[a-z][a-z0-9-]{1,28}[a-z0-9]$'   # 3-30 characters
HANDLE_RE='^[a-z][a-z0-9-]{0,30}[a-z0-9]$'   # the registrar's rule

# name_free <pen>: 0 free, 2 taken (a pen here has it, or it was ever used:
# D-21), 1 can't tell. Fails closed.
name_free() {
  [ -e "$PENS/$1" ] && return 2
  [ -n "${PENS_ZONE:-}" ] && [ -x "$CDNS_BIN" ] || return 1
  case "$(cdns name used "$1" 2>/dev/null)" in
    free) return 0 ;;
    used) return 2 ;;
    *) return 1 ;;
  esac
}

live_pens() { local n c=0; for n in $(pen_names); do [ -f "$PENS/$n/.removed" ] || [ -f "$PENS/$n/.sleeping" ] || c=$((c + 1)); done; echo "$c"; }
renew_wake_pens() { local n c=0; for n in $(pen_names); do [ -f "$PENS/$n/.removed" ] || [ -f "$PENS/$n/.retired" ] && continue; [ -f "$PENS/$n/.renew-wake" ] && c=$((c + 1)); done; echo "$c"; }

set_host_var() {  # set_host_var KEY value: in host.env, replacing any old value
  # host.env is sourced, so quote the value (a sender like "Hogman <x@y>"
  # would otherwise be read as a redirection). Single quotes, with any ' escaped.
  local tmp v; tmp="$(mktemp)"
  v="$(printf '%s' "$2" | sed "s/'/'\\\\''/g")"
  grep -v "^$1=" "$HOSTENV" > "$tmp" || true
  printf "%s='%s'\n" "$1" "$v" >> "$tmp"
  install -m 0600 "$tmp" "$HOSTENV"; rm -f "$tmp"
}

cmd_capacity() {
  load_host
  local n max="${MAX_PENS:-8}" wakes reserve="${RENEW_WAKE_RESERVE:-2}"
  n="$(live_pens)"
  wakes="$(renew_wake_pens)"
  printf '{"pens":%d,"max":%d,"open":%s,"renew_wakes":%d,"renew_reserve":%d}\n' \
    "$n" "$max" "$([ "$n" -lt "$max" ] && echo true || echo false)" "$wakes" "$reserve"
}

# provision <pen> <owner>: raise <pen>.<GATE_DOMAIN> with <owner> as its keeper
# and print, as JSON, the one-time link that joins the keeper's first device.
# Exit 2: the name is taken. Exit 3: the server is full.
cmd_provision() {
  load_host
  local n="${1:-}" owner="${2:-}" theme="" plan=""
  shift 2 || die "usage: hogman-host provision <pen> <owner> [--theme work|default] [--plan personal|work]"
  while [ $# -gt 0 ]; do
    case "$1" in
      --theme)
        [ $# -ge 2 ] || die "usage: hogman-host provision <pen> <owner> [--theme work|default] [--plan personal|work]"
        case "$2" in
          default|"") theme="" ;;
          work) theme="work" ;;
          *) die "unknown theme: $2 (want default or work)" ;;
        esac
        shift 2 ;;
      --plan)
        [ $# -ge 2 ] || die "usage: hogman-host provision <pen> <owner> [--theme work|default] [--plan personal|work]"
        case "$2" in
          personal|"") plan="" ;;
          work) plan="work" ;;
          *) die "unknown plan: $2 (want personal or work)" ;;
        esac
        shift 2 ;;
      *) die "usage: hogman-host provision <pen> <owner> [--theme work|default] [--plan personal|work]" ;;
    esac
  done
  [ -n "${PENS_DOMAIN:-}" ] || die "sign-ups are not set up: hogman-host signup-setup"
  [ -n "${PENS_ZONE:-}" ] && [ -n "${GATE_DOMAIN:-}" ] || die "public pens aren't set up here yet: hogman-host gate-cert-setup, then hogman-host pens-zone"
  [[ "$n" =~ $HOSTED_RE ]] || die "pen names are 3-30 lowercase letters, digits and dashes, starting with a letter"
  [[ "$owner" =~ $HANDLE_RE ]] || die "invalid handle: $owner"
  [ -s "$RECIPIENT" ] || die "no backup key: run hogman-host backup-setup first"
  [ -e "$PENS/$n" ] && { echo "hogman-host: pen $n already exists" >&2; exit 2; }
  name_free "$n" || { [ $? = 2 ] && { echo "hogman-host: the pen name $n was used before" >&2; exit 2; }; die "couldn't check whether $n was used before"; }
  [ "$(live_pens)" -lt "${MAX_PENS:-8}" ] || { echo "hogman-host: this server is full" >&2; exit 3; }
  # All or nothing: a pen that fails half-way is taken down again, so its name
  # and memory aren't stuck, and kept in failed/ to see what went wrong.
  # (Not `if ! ( ... )`: bash ignores set -e inside a subshell used as a condition.)
  local res rc; res="$(mktemp)"
  set +e
  ( set -e; provision_steps "$n" "$owner" "$theme" "$plan" ) > "$res"
  rc=$?
  set -e
  if [ "$rc" -ne 0 ]; then
    rm -f "$res"
    provision_rollback "$n"
    die "raising $n failed; rolled back (its folder is in $HOGMAN_HOME/failed/)"
  fi
  local link exp zone="$n.$PENS_ZONE" host="$n.$GATE_DOMAIN" extra_json=""
  link="$(sed -n 1p "$res")"; exp="$(sed -n 2p "$res")"; rm -f "$res"
  [ -n "$theme" ] && extra_json="${extra_json}$(printf ',"theme":"%s"' "$theme")"
  [ -n "$plan" ] && extra_json="${extra_json}$(printf ',"plan":"%s"' "$plan")"
  info "pen $n raised for $owner"
  printf '{"pen":"%s","zone":"%s","host":"%s","owner":"%s","join_link":"%s","valid_until":"%s"%s}\n' \
    "$n" "$zone" "$host" "$owner" "$link" "$exp" "$extra_json"
}

# signup-setup <pens-domain> <signup-host> [max-pens]: turn on the sign-up page.
# Pens get <name>.<pens-domain>; point *.<pens-domain> and <signup-host> here.
provision_steps() {  # in a subshell: prints the join link, then its expiry
  local n="$1" owner="$2" theme="${3:-}" plan="${4:-}" out link
  local add_args=("$n")
  [ -n "$theme" ] && add_args+=(--theme "$theme")
  [ -n "$plan" ] && add_args+=(--plan "$plan")
  cmd_add "${add_args[@]}" >&2
  echo "HOSTED=true" >> "$PENS/$n/.env"
  (cd "$PENS/$n" && ./hogman member add "$owner" --role owner) >&2
  out="$(cd "$PENS/$n" && ./hogman device key "$owner" personal)"
  link="$(awk '/^link:/ {print $2}' <<<"$out")"
  [[ "$link" =~ ^https://[a-z0-9.-]+/join#k=[A-Za-z0-9_-]+$ ]] || die "no join link for $owner: $out"
  echo "$link"
  awk '/^valid until/ {print $3, $4}' <<<"$out" | tr -d ','  # "valid until <date> <time>, single use"
}

provision_rollback() {
  local n="$1"
  [ -d "$PENS/$n" ] || return 0
  (cd "$PENS/$n" && ./hogman down -v --remove-orphans >/dev/null 2>&1) || true
  # A half-made public pen holds a live challenge DNS credential: revoke it
  # and release its name if no ACME challenge was ever written (D-21 still
  # retires the name permanently once any certificate challenge occurred).
  if [ -s "$PENS/$n/.challenge-dns-id" ]; then
    local cid; cid="$(cat "$PENS/$n/.challenge-dns-id")"
    if cdns cred rm "$cid" --release-if-unused >/dev/null 2>&1 || cdns cred rm "$cid" >/dev/null 2>&1; then
      rm -f "$PENS/$n/.challenge-dns-id"
    else
      info "could not revoke $n's challenge DNS credential; do it by hand: hogman-host challenge-dns cred list"
    fi
  fi
  rm -f "$PENS/$n/data/secrets/registrar/challenge_dns_token"
  install -d -m 0700 "$HOGMAN_HOME/failed"
  mv "$PENS/$n" "$HOGMAN_HOME/failed/$n-$(date -u +%Y%m%dT%H%M%SZ)"
  write_front; reload_front
  docker network rm "pen-$n-core" >/dev/null 2>&1 || true
}

cmd_signup_setup() {
  load_host
  # With no arguments: refresh it with the saved settings (install.sh does this).
  local domain="${1:-${GATE_DOMAIN:-${PENS_DOMAIN:-}}}" host="${2:-${SIGNUP_HOST:-}}" max="${3:-${MAX_PENS:-8}}"
  valid_host "$domain" && valid_host "$host" || die "usage: hogman-host signup-setup <front-door-domain> <signup-host> [max-pens]"
  [ -n "${PENS_ZONE:-}" ] && [ -n "${GATE_DOMAIN:-}" ] \
    || die "public pens aren't set up here yet: hogman-host gate-cert-setup, then hogman-host pens-zone"
  [ "$domain" = "$GATE_DOMAIN" ] \
    || die "the front-door domain must be the gate domain: hogman-host signup-setup $GATE_DOMAIN $host"
  [[ "$max" =~ ^[0-9]+$ ]] && [ "$max" -ge 1 ] && [ "$max" -le 100 ] || die "max-pens is 1-100"
  [ -s "$RECIPIENT" ] || die "set up backups first: hogman-host backup-setup"
  [ -d "$HOGMAN_HOME/signup-src" ] || die "no sign-up code in $HOGMAN_HOME/signup-src (install.sh puts it there)"
  set_host_var PENS_DOMAIN "$domain"
  set_host_var SIGNUP_HOST "$host"
  set_host_var MAX_PENS "$max"
  load_host
  install -d -m 0700 "$SIGNUP"
  [ -f "$SIGNUP/codes" ] || install -m 0600 /dev/null "$SIGNUP/codes"
  # Readable by root (broker) and group 65534 (unprivileged web container) only.
  if [ ! -s "$SIGNUP/token" ]; then
    ( umask 077; head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$SIGNUP/token" )
  fi
  chown 0:65534 "$SIGNUP/token" 2>/dev/null || true
  chmod 0440 "$SIGNUP/token"
  rsync -a --delete "$HOGMAN_HOME/signup-src/" "$SIGNUP/build/"
  local arch dockerfile=Dockerfile
  case "$(uname -m)" in x86_64|amd64) arch=amd64 ;; aarch64|arm64) arch=arm64 ;; *) arch="" ;; esac
  if [ -n "$arch" ] && [ -f "$SRC/prebuilt/signup/hogman-signup-linux-$arch" ]; then
    install -m 0755 "$SRC/prebuilt/signup/hogman-signup-linux-$arch" "$SIGNUP/build/hogman-signup.bin"
    dockerfile=Dockerfile.prebuilt
  fi
  # The broker runs this very script; Docker needs its absolute path.
  local hostbin; hostbin="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  # The broker is as powerful as root, so it gets no internet unless the
  # operator turned on push notifications (the only thing it sends out).
  # Docker itself pulls images and builds; the broker only asks it to.
  local broker_nets="[signup]" out_net="" broker_mail="" broker_backups_vol=""
  if [ -s "$SIGNUP/resend_key" ] && [ -n "${SIGNUP_FROM:-}" ]; then
    broker_mail="      RESEND_API_KEY_FILE: $SIGNUP/resend_key
      BILLING_FROM: \"$SIGNUP_FROM\""
  fi
  if [ -n "${SIGNUP_NTFY:-}" ] || [ -n "$broker_mail" ]; then
    broker_nets="[signup, out]"; out_net="  out: {}"
  fi
  if [ -d "$BACKUPS" ]; then
    broker_backups_vol="      - $BACKUPS:$BACKUPS
"
  fi
  # Selling pens (signup-stripe): the page gets the Stripe key, the broker the
  # webhook secret it checks Stripe's events with.
  local web_extra_vols="" web_stripe="" broker_stripe=""
  if [ -n "${SIGNUP_STRIPE_PRICE:-}" ] && [ -s "$SIGNUP/stripe_key" ] && [ -s "$SIGNUP/stripe_webhook_secret" ]; then
    web_extra_vols="${web_extra_vols}      - ./stripe_key:/run/secrets/stripe_key:ro
"
    web_stripe="      STRIPE_SECRET_KEY_FILE: /run/secrets/stripe_key
      STRIPE_PRICE: $SIGNUP_STRIPE_PRICE
      STRIPE_WORK_PRICE: \"${SIGNUP_STRIPE_WORK_PRICE:-}\"
      STRIPE_AUTOMATIC_TAX: \"${SIGNUP_STRIPE_TAX:-}\"
      PUBLIC_URL: https://$SIGNUP_HOST"
    local expect_live="0"
    case "$(cat "$SIGNUP/stripe_key" 2>/dev/null)" in *_live_*) expect_live="1" ;; esac
    broker_stripe="      STRIPE_WEBHOOK_SECRET_FILE: $SIGNUP/stripe_webhook_secret
      STRIPE_EXPECT_LIVEMODE: \"$expect_live\"
      STRIPE_MIN_PERSONAL_CENTS: \"${SIGNUP_STRIPE_MIN_PERSONAL_CENTS:-5000}\"
      STRIPE_MIN_WORK_CENTS: \"${SIGNUP_STRIPE_MIN_WORK_CENTS:-12000}\"
      STRIPE_CURRENCY: \"${SIGNUP_STRIPE_CURRENCY:-usd}\""
  fi
  local cf_env=""
  if [ "${SIGNUP_CLOUDFLARE:-}" = 1 ]; then
    cf_env="      TRUST_CLOUDFLARE: \"1\"
      TRUSTED_PROXY_CIDRS: \"$CLOUDFLARE_CIDRS\""
  fi
  local ts_env="" ts_hosts="$SIGNUP_HOST"
  if [ -n "${SIGNUP_WORK_HOST:-}" ] && [ "$SIGNUP_WORK_HOST" != "$SIGNUP_HOST" ]; then
    ts_hosts="$SIGNUP_HOST,$SIGNUP_WORK_HOST"
  fi
  if [ -n "${SIGNUP_TURNSTILE_SITE_KEY:-}" ] && [ -s "$SIGNUP/turnstile.secret" ]; then
    ts_env="      TURNSTILE_SITE_KEY: $SIGNUP_TURNSTILE_SITE_KEY
      TURNSTILE_SECRET_FILE: /run/secrets/turnstile
      TURNSTILE_EXPECTED_HOSTS: $ts_hosts"
    web_extra_vols="${web_extra_vols}      - ./turnstile.secret:/run/secrets/turnstile:ro
"
  fi
  cat > "$SIGNUP/compose.yaml" <<EOF
# Written by hogman-host signup-setup.
name: hogman-signup
services:
  # The public page. No privileges; it can only ask the broker.
  web:
    build: { context: ./build, dockerfile: $dockerfile, target: web }
    image: hogman/signup-web:local
    restart: unless-stopped
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    user: "65534:65534"
    mem_limit: 64m
    pids_limit: 64
    environment:
      ROLE: web
      BROKER_URL: http://broker:9090
      BROKER_TOKEN_FILE: /run/secrets/token
      PENS_DOMAIN: $PENS_DOMAIN
      SITES_DOMAIN: $PENS_ZONE
      WORK_SIGNUP_HOST: "${SIGNUP_WORK_HOST:-}"
$cf_env
$web_stripe
$ts_env
    volumes:
      - ./token:/run/secrets/token:ro
$web_extra_vols
    networks:
      hogman-front: { aliases: [signup] }
      signup: {}
  # Raises pens. It drives Docker, so it is as powerful as root: it listens
  # only on the private network it shares with the page, and does four things:
  # capacity, name check, raise a pen with a valid code, add to the waiting list.
  broker:
    build: { context: ./build, dockerfile: $dockerfile, target: broker }
    image: hogman/signup-broker:local
    restart: unless-stopped
    security_opt: [no-new-privileges:true]
    # Runs hogman-signup plus docker-cli/compose/buildx during pen provisioning;
    # 128m could OOM-kill the broker mid-provision (I-5).
    mem_limit: 384m
    pids_limit: 256
    environment:
      ROLE: broker
      HOGMAN_HOME: $HOGMAN_HOME
      HOGMAN_HOST_TOOL: /usr/local/bin/hogman-host
      BROKER_TOKEN_FILE: $SIGNUP/token
      PUBLIC_URL: https://$SIGNUP_HOST
      WORK_SIGNUP_HOST: "${SIGNUP_WORK_HOST:-}"
      RENEW_WAKE_RESERVE: "${RENEW_WAKE_RESERVE:-2}"
      NTFY_URL: ${SIGNUP_NTFY:-}
$broker_mail
$broker_stripe
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - $HOGMAN_HOME:$HOGMAN_HOME
      - $hostbin:/usr/local/bin/hogman-host:ro
      - $CDNS_BIN:$CDNS_BIN:ro
      - $(dirname "$CDNS_ADMIN"):$(dirname "$CDNS_ADMIN")
      # Read-only: the broker rewrites the front door's routes when it raises a
      # pen, and a route uses the *.<gate> wildcard only if these files exist.
      # Without them every gate route lost its certificate line.
      - $GATE_TLS:$GATE_TLS:ro
$broker_backups_vol
    # signup: the page reaches it here (internal: no internet). out, only with
    # push notifications on: nothing else is on it, so nothing reaches it there.
    networks: $broker_nets
    healthcheck:
      test: ["CMD", "hogman-signup", "health"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 15s
networks:
  hogman-front: { external: true }
  signup: { internal: true }
$out_net
EOF
  cmd_pull_images
  (cd "$SIGNUP" && docker compose up -d --build --remove-orphans >&2) || die "the sign-up page did not start: cd $SIGNUP && docker compose logs"
  write_front
  reload_front
  if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
    cmd_lifecycle_setup
  fi
  info "Sign-ups on: https://$SIGNUP_HOST, front doors at <name>.$PENS_DOMAIN, at most $MAX_PENS here."
  info "DNS: point $SIGNUP_HOST and *.$PENS_DOMAIN at this server. Then: hogman-host signup-code"
}

# rand_chars N: N random characters from an alphabet without 0/O or 1/I.
# (No `tr </dev/urandom | head`: head closing the pipe fails under pipefail.)
rand_chars() {
  od -An -N "$1" -tu1 /dev/urandom | awk -v a=ABCDEFGHJKLMNPQRSTUVWXYZ23456789 \
    '{ for (i = 1; i <= NF; i++) printf "%s", substr(a, $i % 32 + 1, 1) }'
}

# make_code <note>: add a single-use sign-up code and print it.
make_code() {
  local note code
  note="$(printf '%s' "$1" | tr -cd 'A-Za-z0-9 ,.@_#-' | cut -c1-80)"
  # No 0/O or 1/I: codes get read out loud and typed.
  code="PIG-$(rand_chars 4)-$(rand_chars 4)"
  with_lock "$SIGNUP/codes.lock" sh -c 'echo "$1" >> "$2"' _ "$code $note" "$SIGNUP/codes"
  echo "$code"
}

# with_lock <lockfile> <command...>: the broker takes the same flock.
with_lock() {
  local l="$1"; shift
  if command -v flock >/dev/null; then flock "$l" "$@"; else "$@"; fi
}

# signup-code [--vanity] [--work] [note]: a single-use code for the sign-up page
# (invite-only sign-ups). Standard codes add a random 4-character suffix to the
# pen name; --vanity tags the code to allow a bare vanity name; --work tags the
# code for a Work pen (PLAN=work, THEME=work, higher certificate caps; D-30).
cmd_signup_code() {
  load_host
  [ -n "${SIGNUP_HOST:-}" ] && [ -f "$SIGNUP/codes" ] || die "sign-ups are not set up: hogman-host signup-setup"
  local vanity=0 work=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --vanity) vanity=1; shift ;;
      --work)   work=1; shift ;;
      --)       shift; break ;;
      -*)       die "usage: hogman-host signup-code [--vanity] [--work] [note]" ;;
      *)        break ;;
    esac
  done
  local note="${*:-}"
  case "$note" in
    vanity|vanity\ *|work|work\ *) die "notes cannot start with 'vanity' or 'work' (use --vanity / --work flags)" ;;
  esac
  local tags=""
  [ "$vanity" = 1 ] && tags="${tags:+$tags }vanity"
  [ "$work" = 1 ] && tags="${tags:+$tags }work"
  local full_note="${tags}${note:+${tags:+ }$note}"
  local code; code="$(make_code "$full_note")"
  local host="$SIGNUP_HOST"
  if [ "$work" = 1 ] && [ -n "${SIGNUP_WORK_HOST:-}" ]; then host="$SIGNUP_WORK_HOST"; fi
  echo "code: $code"
  local link="https://$host/#code=$code"
  [ "$vanity" = 1 ] && link="${link}&vanity=1"
  echo "link: $link"
  local desc=""
  if [ "$vanity" = 1 ]; then desc="vanity pen name — no random ending"; else desc="pen gets a 4-character random ending"; fi
  [ "$work" = 1 ] && desc="Work plan, $desc"
  echo "works once ($desc)"
}

# --------------------------------------------------------- waiting list ----
# $SIGNUP/waitlist: one person per line, tab-separated:
#   id  added-at  status  email  pen  note      (status: waiting | invited <code>)
# The sign-up page's broker appends to it; these commands read and edit it,
# under the same lock. When someone signs up with their code, the broker
# removes their line, as the page promises.

WAITLIST_FILE() { echo "$SIGNUP/waitlist"; }

cmd_waitlist() {
  load_host
  [ -n "${SIGNUP_HOST:-}" ] || die "sign-ups are not set up: hogman-host signup-setup"
  local w; w="$(WAITLIST_FILE)"
  case "${1:-list}" in
    list)
      [ -s "$w" ] || { echo "nobody waiting"; return; }
      awk -F'\t' 'BEGIN { printf "%-4s %-17s %-22s %-34s %-14s %s\n", "ID", "ADDED", "STATUS", "EMAIL", "PEN", "NOTE" }
        { printf "%-4s %-17s %-22s %-34s %-14s %s\n", $1, substr($2, 1, 16), $3, $4, $5, $6 }' "$w"
      echo "$(awk -F'\t' '$3 == "waiting"' "$w" | wc -l | tr -d ' ') waiting" ;;
    invite) shift; waitlist_invite "${1:-}" ;;
    remove) shift; waitlist_remove "${1:-}" ;;
    *) die "usage: hogman-host waitlist [list | invite <id> | remove <id>]" ;;
  esac
}

waitlist_field() {  # waitlist_field <id> <column>
  awk -F'\t' -v id="$1" -v c="$2" '$1 == id { print $c }' "$(WAITLIST_FILE)"
}

waitlist_set_status() {  # waitlist_set_status <id> <status>  (empty status: delete the line)
  local w tmp; w="$(WAITLIST_FILE)"; tmp="$w.new.$$"
  with_lock "$w.lock" sh -c '
    awk -F"\t" -v OFS="\t" -v id="$1" -v st="$2" "\$1 == id { if (st == \"\") next; \$3 = st } { print }" "$3" > "$4" \
      && chmod 600 "$4" && mv "$4" "$3"' _ "$1" "$2" "$w" "$tmp"
}

waitlist_invite() {
  local id="$1" status email pen code link
  [[ "$id" =~ ^[0-9]+$ ]] || die "usage: hogman-host waitlist invite <id>"
  status="$(waitlist_field "$id" 3)"
  [ -n "$status" ] || die "nobody with id $id on the waiting list"
  [ "$status" = waiting ] || die "$id is already: $status"
  email="$(waitlist_field "$id" 4)"; pen="$(waitlist_field "$id" 5)"
  code="$(make_code "waitlist #$id")"
  link="https://$SIGNUP_HOST/#code=$code"
  waitlist_set_status "$id" "invited $code"
  if [ -s "$SIGNUP/resend_key" ] && [ -n "${SIGNUP_FROM:-}" ]; then
    if send_invite_mail "$email" "$code" "$link" "$pen"; then
      info "emailed $email their code $code"
    else
      info "could not email $email; send this yourself:"; invite_text "$code" "$link" "$pen"
    fi
  else
    info "no mail set up (hogman-host signup-mail); send this to $email yourself:"
    echo; invite_text "$code" "$link" "$pen"
  fi
}

waitlist_remove() {
  local id="$1"
  [[ "$id" =~ ^[0-9]+$ ]] || die "usage: hogman-host waitlist remove <id>"
  [ -n "$(waitlist_field "$id" 1)" ] || die "nobody with id $id on the waiting list"
  waitlist_set_status "$id" ""
  info "removed $id from the waiting list"
}

invite_text() {  # invite_text <code> <link> <pen>
  # (The pen line is built here: bash 3.2 can't parse ${3:+...} with a quote in a heredoc.)
  local penline=""
  [ -n "$3" ] && penline="You asked for the name $3; it's yours if nobody took it first.
"
  cat <<EOF
There's room on the farm. Here is your Hogman sign-up code:

    $1

Get your pen here (the code is filled in): $2
${penline}It works once. We'll delete your email from our waiting list once you've
signed up. If you didn't ask for this, ignore this email.

Clean pigs only.
Hogman
EOF
}

send_invite_mail() {  # send_invite_mail <to> <code> <link> <pen>
  local body; body="$(invite_text "$2" "$3" "$4" | sed 's/\\/\\\\/g; s/"/\\"/g' | awk '{ printf "%s\\n", $0 }')"
  resend_send "$1" "Your Hogman sign-up code" "$body"
}

resend_send() {  # resend_send <to> <subject> <json-escaped text>
  # <to> passed the page's email check (no quotes or backslashes), and the
  # rest is ours, so plain printf is enough to build the JSON. Pass the API
  # key via a curl config fd so it never appears in /proc/<pid>/cmdline.
  printf '{"from":"%s","to":["%s"],"subject":"%s","text":"%s"}' "$SIGNUP_FROM" "$1" "$2" "$3" \
    | curl -fsS -m 20 -o /dev/null https://api.resend.com/emails \
        -K <(printf 'header = "Authorization: Bearer %s"\n' "$(cat "$SIGNUP/resend_key")") \
        -H "Content-Type: application/json" --data-binary @-
}

# signup-mail "<from>" < key: email codes to the waiting list through Resend
# (https://resend.com). The API key comes on standard input, so it never sits
# in your shell history. signup-mail test <address>: send a test email.
cmd_signup_mail() {
  load_host
  [ -d "$SIGNUP" ] || die "sign-ups are not set up: hogman-host signup-setup"
  if [ "${1:-}" = test ]; then
    [ -s "$SIGNUP/resend_key" ] && [ -n "${SIGNUP_FROM:-}" ] || die "set it up first: hogman-host signup-mail \"Hogman <pens@example.com>\" < key"
    local addr_re='^[^<>"\\[:space:]]+@[A-Za-z0-9.-]+\.[A-Za-z]+$'
    [[ "${2:-}" =~ $addr_re ]] || die "usage: hogman-host signup-mail test <your email>"
    resend_send "$2" "Hogman: test email" "This is a test from hogman-host on $(hostname). Mail works.\\n" \
      && info "sent a test email to $2" || die "Resend refused it (check the key and that the sender's domain is verified)"
    return
  fi
  local from="${1:-}" key
  local bare_re='^[^<>"\\[:space:]]+@[A-Za-z0-9.-]+\.[A-Za-z]+$' named_re='^[A-Za-z0-9 ]+ <[^<>"\\[:space:]]+@[A-Za-z0-9.-]+\.[A-Za-z]+>$'
  [[ "$from" =~ $bare_re || "$from" =~ $named_re ]] || die 'usage: hogman-host signup-mail "Hogman <pens@your.domain>" < resend-api-key'
  [ -t 0 ] && die "pipe the Resend API key in on standard input, e.g. < keyfile"
  key="$(tr -d ' \r\n' | head -c 200)"
  [[ "$key" =~ ^re_[A-Za-z0-9_]+$ ]] || die "that doesn't look like a Resend API key (re_...)"
  ( umask 077; printf '%s' "$key" > "$SIGNUP/resend_key" )
  set_host_var SIGNUP_FROM "$from"
  info "Mail will be sent from $from. Try: hogman-host signup-mail test <your email>"
  if [ -f "$SIGNUP/compose.yaml" ]; then
    info "Run 'hogman-host signup-setup' so the sign-up broker picks up the updated mail settings."
  fi
}

# signup-notify <ntfy topic URL>: a push when someone joins the waiting list or
# a pen is raised (never personal details). "off" turns it off.
cmd_signup_notify() {
  load_host
  local u="${1:-}"
  if [ "$u" = off ]; then u=""; else
    [[ "$u" =~ ^https://[A-Za-z0-9.-]+/[A-Za-z0-9_-]{8,64}$ ]] || die "usage: hogman-host signup-notify https://ntfy.sh/<topic> | off"
  fi
  set_host_var SIGNUP_NTFY "$u"
  cmd_signup_setup
  info "Sign-up pushes ${u:+go to $u}${u:-are off}"
}

# signup-stripe <price-id> [--work <work-price-id>] [tax] < keys: sell pens on
# the sign-up page with Stripe Checkout (D-28). Standard input: the Stripe API
# key (best a restricted key with Checkout Sessions: Write and Subscriptions:
# Write so replaced subscriptions can be cancelled on manual renewal, I-6),
# then the webhook signing secret (whsec_...), one per line. "tax" turns on
# Stripe Tax. "work-price <price-id>|off" updates the optional Work price
# without re-piping keys. "floor <personal-cents> <work-cents> [currency]"
# overrides the broker webhook price/currency floor (default 5000 12000 usd, M2).
# "off" stops selling.
# Webhook endpoint (in Stripe): https://<signup-host>/api/stripe/webhook, events
# checkout.session.completed, checkout.session.async_payment_succeeded,
# invoice.paid and customer.subscription.deleted.
cmd_signup_stripe() {
  load_host
  local price="${1:-}" work_price="" tax=""
  if [ "$price" = off ]; then
    rm -f "$SIGNUP/stripe_key" "$SIGNUP/stripe_webhook_secret"
    set_host_var SIGNUP_STRIPE_PRICE ""
    set_host_var SIGNUP_STRIPE_WORK_PRICE ""
    set_host_var SIGNUP_STRIPE_TAX ""
    set_host_var SIGNUP_STRIPE_MIN_PERSONAL_CENTS ""
    set_host_var SIGNUP_STRIPE_MIN_WORK_CENTS ""
    set_host_var SIGNUP_STRIPE_CURRENCY ""
    cmd_signup_setup
    info "Pens aren't for sale on the sign-up page any more"
    return
  fi
  if [ "$price" = floor ]; then
    local pmin="${2:-}" wmin="${3:-}" cur="${4:-usd}"
    [[ "$pmin" =~ ^[1-9][0-9]{0,7}$ ]] && [[ "$wmin" =~ ^[1-9][0-9]{0,7}$ ]] \
      && [[ "$cur" =~ ^[a-zA-Z]{3}$ ]] \
      || die "usage: hogman-host signup-stripe floor <personal-cents> <work-cents> [3-letter-currency]"
    cur="$(printf '%s' "$cur" | tr 'A-Z' 'a-z')"
    [ -n "${SIGNUP_STRIPE_PRICE:-}" ] && [ -s "$SIGNUP/stripe_key" ] || die "configure Stripe first: hogman-host signup-stripe <price_...> < keys"
    set_host_var SIGNUP_STRIPE_MIN_PERSONAL_CENTS "$pmin"
    set_host_var SIGNUP_STRIPE_MIN_WORK_CENTS "$wmin"
    set_host_var SIGNUP_STRIPE_CURRENCY "$cur"
    cmd_signup_setup
    info "Stripe broker floor updated: personal>=${pmin}c work>=${wmin}c currency=${cur}"
    return
  fi
  if [ "$price" = work-price ]; then
    local wp="${2:-}"
    [ -n "${SIGNUP_STRIPE_PRICE:-}" ] && [ -s "$SIGNUP/stripe_key" ] || die "configure Stripe first: hogman-host signup-stripe <price_...> < keys"
    if [ "$wp" = off ]; then
      set_host_var SIGNUP_STRIPE_WORK_PRICE ""
      cmd_signup_setup
      info "Work sign-up host Stripe checkout is off (set work-price <price_...> to re-enable)"
      return
    fi
    [[ "$wp" =~ ^price_[A-Za-z0-9]{6,64}$ ]] || die "usage: hogman-host signup-stripe work-price <price_...>|off"
    set_host_var SIGNUP_STRIPE_WORK_PRICE "$wp"
    cmd_signup_setup
    info "Work sign-up host now uses Stripe price $wp"
    return
  fi
  [[ "$price" =~ ^price_[A-Za-z0-9]{6,64}$ ]] || die "usage: hogman-host signup-stripe <price_...> [--work <price_...>] [tax] < keys   |   work-price <price_...>|off   |   off"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --work)
        [ $# -ge 2 ] || die "usage: hogman-host signup-stripe <price_...> [--work <price_...>] [tax] < keys"
        [[ "$2" =~ ^price_[A-Za-z0-9]{6,64}$ ]] || die "invalid --work Stripe price ID: $2"
        work_price="$2"
        shift 2 ;;
      tax)
        tax=1
        shift ;;
      *) die "unknown argument: $1 (want --work <price_...> or tax)" ;;
    esac
  done
  [ -t 0 ] && die "pipe the keys in on standard input: the API key, then the webhook secret, one per line"
  local key whsec
  IFS= read -r key || true
  IFS= read -r whsec || true
  key="$(printf '%s' "$key" | tr -d ' \r\n')"; whsec="$(printf '%s' "$whsec" | tr -d ' \r\n')"
  [[ "$key" =~ ^(sk|rk)_(test|live)_[A-Za-z0-9]{10,200}$ ]] || die "the first line isn't a Stripe secret or restricted key (sk_... or rk_...)"
  [[ "$whsec" =~ ^whsec_[A-Za-z0-9]{10,200}$ ]] || die "the second line isn't a Stripe webhook signing secret (whsec_...)"
  [ -d "$SIGNUP" ] || die "set up the sign-up page first: hogman-host signup-setup"
  # The page runs as nobody (65534) and reads the key; only root reads the secret.
  ( umask 077; printf '%s' "$key" > "$SIGNUP/stripe_key"; printf '%s' "$whsec" > "$SIGNUP/stripe_webhook_secret" )
  chown 65534:65534 "$SIGNUP/stripe_key"; chmod 0400 "$SIGNUP/stripe_key"
  set_host_var SIGNUP_STRIPE_PRICE "$price"
  set_host_var SIGNUP_STRIPE_WORK_PRICE "$work_price"
  set_host_var SIGNUP_STRIPE_TAX "$tax"
  cmd_signup_setup
  local mode=test; case "$key" in *_live_*) mode=live ;; esac
  info "Pens are for sale on https://$SIGNUP_HOST ($mode mode${work_price:+, Work price $work_price}${tax:+, Stripe Tax on})."
  info "Stripe webhook: https://$SIGNUP_HOST/api/stripe/webhook"
}

# signup-cloudflare on|off: when get.<domain> sits behind Cloudflare Proxy
# (CF_PROXY_ON), trust CF-Connecting-IP strictly from Cloudflare edge CIDRs
# and reject direct-to-origin bypasses at the front door with 403.
cmd_signup_cloudflare() {
  load_host
  [ -n "${SIGNUP_HOST:-}" ] && [ -d "$SIGNUP" ] || die "sign-ups are not set up: hogman-host signup-setup"
  case "${1:-}" in
    on)  set_host_var SIGNUP_CLOUDFLARE 1 ;;
    off) set_host_var SIGNUP_CLOUDFLARE "" ;;
    *)   die "usage: hogman-host signup-cloudflare on|off" ;;
  esac
  cmd_signup_setup
  info "Sign-up Cloudflare proxy lock is ${1}"
}

# signup-turnstile <site-key>|off: require Cloudflare Turnstile on sign-up and
# waiting-list forms. The secret key is read from standard input so it never
# sits in shell history.
cmd_signup_turnstile() {
  load_host
  [ -n "${SIGNUP_HOST:-}" ] && [ -d "$SIGNUP" ] || die "sign-ups are not set up: hogman-host signup-setup"
  local sk="${1:-}"
  if [ "$sk" = off ]; then
    rm -f "$SIGNUP/turnstile.secret"
    set_host_var SIGNUP_TURNSTILE_SITE_KEY ""
    cmd_signup_setup
    info "Sign-up Cloudflare Turnstile is off"
    return
  fi
  [[ "$sk" =~ ^[0-9A-Za-z_-]{8,128}$ ]] || die "usage: hogman-host signup-turnstile <site-key> < secret-file  (or: off)"
  [ -t 0 ] && die "pipe the Turnstile secret key in on standard input, e.g. < secret-file"
  local sec; sec="$(tr -d ' \r\n' | head -c 256)"
  [[ "$sec" =~ ^[0-9A-Za-z_-]{8,256}$ ]] || die "that doesn't look like a Turnstile secret key"
  # Readable only by the unprivileged web container (65534:65534); matches stripe_key.
  ( umask 077; printf '%s' "$sec" > "$SIGNUP/turnstile.secret" )
  chown 65534:65534 "$SIGNUP/turnstile.secret"; chmod 0400 "$SIGNUP/turnstile.secret"
  set_host_var SIGNUP_TURNSTILE_SITE_KEY "$sk"
  cmd_signup_setup
  info "Sign-up Cloudflare Turnstile is on (site key $sk)"
}

# signup-work-host <host>|off: serve the same sign-up page on a Work hostname
# (e.g. get.work.hogman.network), defaulting pens raised there to THEME=work
# and keeping Stripe Checkout redirects on that host.
cmd_signup_work_host() {
  load_host
  [ -n "${SIGNUP_HOST:-}" ] && [ -d "$SIGNUP" ] || die "sign-ups are not set up: hogman-host signup-setup"
  local h="${1:-}"
  if [ "$h" = off ]; then
    set_host_var SIGNUP_WORK_HOST ""
    cmd_signup_setup
    info "Work sign-up host is off"
    return
  fi
  valid_host "$h" || die "usage: hogman-host signup-work-host <host>|off"
  [ "$h" != "$SIGNUP_HOST" ] || die "work sign-up host must differ from $SIGNUP_HOST"
  set_host_var SIGNUP_WORK_HOST "$h"
  cmd_signup_setup
  info "Work sign-up host is on: https://$h"
}

# challenge-dns-setup <public-ip> [gcp-key.json]: install and run the DNS-01
# challenge server (deploy/challenge-dns) as a locked-down systemd service.
# It answers only for pens.hogman.network and the front door's challenge name,
# and only once Cloudflare delegates those to ns1 (docs: public-certificates).
CDNS_BIN=/usr/local/bin/challenge-dns
CDNS_UNIT=/etc/systemd/system/hogman-challenge-dns.service
CDNS_USER=hogman-cdns
CDNS_KEY=/etc/hogman/gcp-eab.json
CDNS_STATE=/var/lib/challenge-dns/state.json
# The admin socket's path. host.env may move it and CDNS_BIN (the shared-host
# test runs its own challenge DNS server); the systemd unit uses the default.
CDNS_ADMIN=/run/challenge-dns/admin.sock
cdns() { CDNS_ADMIN_SOCK="$CDNS_ADMIN" "$CDNS_BIN" "$@"; }

# pens-zone <zone>: the zone hosted pens live under (D-18), e.g.
# pens.hogman.network. Set it at the switch-over, once that zone is delegated
# to this server's challenge DNS server: from then on `add <pen>` and sign-ups
# make public-certificate pens.
cmd_pens_zone() {
  load_host
  local z="${1:-}"
  valid_host "$z" || die "usage: hogman-host pens-zone <zone>   (e.g. pens.hogman.network)"
  [ -n "${GATE_DOMAIN:-}" ] || die "set up the front door's wildcard first: hogman-host gate-cert-setup <gate-domain>"
  [ -x "$CDNS_BIN" ] && cdns cred list >/dev/null 2>&1 || die "the challenge DNS server isn't answering: hogman-host challenge-dns-setup <public-ip>"
  set_host_var PENS_ZONE "$z"
  info "New pens: front door <pen>.$GATE_DOMAIN, sites under <pen>.$z"
}
PEN_GID=65532   # the group the pens' registrars run as (H3); it may use the API socket

# fallback-contact <email>: the operator address put on Google (fallback CA)
# accounts, which Google requires. Kept in a systemd drop-in, so re-running
# challenge-dns-setup keeps it. Let's Encrypt accounts stay without one.
CDNS_CONTACT_DROPIN=/etc/systemd/system/hogman-challenge-dns.service.d/contact.conf
cmd_fallback_contact() {
  local addr="${1:-}"   # no %: systemd would read it as a specifier
  [[ "$addr" =~ ^[A-Za-z0-9._+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] \
    || die "usage: hogman-host fallback-contact <email>   (an operator address, e.g. ops@example.com)"
  [ -f "$CDNS_UNIT" ] || die "set up the challenge DNS server first: hogman-host challenge-dns-setup <public-ip> <gcp-key.json>"
  install -d -m 0755 "$(dirname "$CDNS_CONTACT_DROPIN")"
  printf '[Service]\nEnvironment=CDNS_GTS_CONTACT=%s\n' "$addr" > "$CDNS_CONTACT_DROPIN"
  systemctl daemon-reload
  systemctl restart hogman-challenge-dns.service
  info "Google fallback accounts will carry $addr"
}
cmd_challenge_dns_setup() {
  load_host
  local ip="${1:-}" key="${2:-}" arch
  valid_ipv4 "$ip" || die "usage: hogman-host challenge-dns-setup <public IPv4 of this server> [gcp-key.json]"
  ip -4 -o addr show scope global 2>/dev/null | grep -Fq " inet $ip/" \
    || die "$ip isn't a public address of this server (answering on 127.0.0.53 would clash with systemd-resolved)"
  case "$(uname -m)" in x86_64|amd64) arch=amd64 ;; aarch64|arm64) arch=arm64 ;; *) die "unsupported CPU $(uname -m)" ;; esac
  local bin="$SRC/prebuilt/challenge-dns/challenge-dns-linux-$arch"
  [ -f "$bin" ] || die "no compiled challenge-dns in this release ($bin); update first: curl -fsSL https://github.com/celtiberi/hogman/releases/latest/download/install.sh | sudo bash"
  install -m 0755 "$bin" "$CDNS_BIN"

  # A fixed system user (not DynamicUser): the API socket's folder is bind-
  # mounted into the registrars, so it must outlive restarts and keep one
  # owner. The registrars' group may use the socket, and nothing else may.
  getent group "$PEN_GID" >/dev/null || groupadd --system --gid "$PEN_GID" hogman-pen
  local pengroup; pengroup="$(getent group "$PEN_GID" | cut -d: -f1)"
  id "$CDNS_USER" >/dev/null 2>&1 || useradd --system --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin "$CDNS_USER"
  cat > /etc/tmpfiles.d/hogman-acme.conf <<TMP
# The challenge DNS API socket's folder: owned by the service, usable by the pens' registrars.
d /run/hogman-acme 0750 $CDNS_USER $pengroup -
TMP
  systemd-tmpfiles --create /etc/tmpfiles.d/hogman-acme.conf

  # The Google key (optional) is handed over as a systemd credential: read
  # only by this service, never in its environment or on its command line.
  # Re-running without a key keeps one already installed.
  if [ -n "$key" ]; then
    [ -f "$key" ] || die "no such file: $key"
    install -d -m 0700 /etc/hogman
    install -m 0600 "$key" "$CDNS_KEY"
  fi
  local cred=""
  [ -f "$CDNS_KEY" ] && cred="LoadCredential=gcp-eab.json:$CDNS_KEY
Environment=CDNS_GCP_KEY=%d/gcp-eab.json"

  # Keep a copy of the state before changing anything (credential hashes and
  # the used pen names, nothing secret beyond the hashes).
  [ -f "$CDNS_STATE" ] && cp -p "$CDNS_STATE" "$CDNS_STATE.bak"

  cat > "$CDNS_UNIT" <<UNIT
[Unit]
Description=Hogman: DNS-01 challenge server (public certificates)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=$CDNS_BIN serve
Environment=CDNS_LISTEN=$ip:53
Environment=CDNS_STATE=$CDNS_STATE
Environment=CDNS_API_SOCK=/run/hogman-acme/api.sock
Environment=CDNS_API_GID=$PEN_GID
Environment=CDNS_ADMIN_SOCK=/run/challenge-dns/admin.sock
$cred
User=$CDNS_USER
Group=$CDNS_USER
SupplementaryGroups=$pengroup
StateDirectory=challenge-dns
StateDirectoryMode=0700
RuntimeDirectory=challenge-dns
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ReadWritePaths=/run/hogman-acme
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
InaccessiblePaths=-$HOGMAN_HOME -/var/lib/hogman-gate -/var/backups
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallFilter=@chown
UMask=0077
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT
  systemctl daemon-reload
  systemctl enable hogman-challenge-dns.service >/dev/null
  systemctl restart hogman-challenge-dns.service
  if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q "Status: active"; then
    ufw allow proto udp to "$ip" port 53 comment "hogman challenge-dns" >/dev/null
    ufw allow proto tcp to "$ip" port 53 comment "hogman challenge-dns" >/dev/null
  fi
  sleep 1
  systemctl is-active --quiet hogman-challenge-dns.service || die "it didn't start: journalctl -u hogman-challenge-dns"
  restart_signup_broker
  info "challenge-dns answers on $ip:53 (UDP and TCP)$( [ -n "$cred" ] && echo ", with the Google fallback CA")"
  [ -n "$cred" ] && [ ! -f "$CDNS_CONTACT_DROPIN" ] && info "Google needs a contact for its accounts: hogman-host fallback-contact <email>"
  info "Check from outside:  dig @$ip pens.hogman.network SOA   (and +tcp)"
  info "If DigitalOcean's cloud firewall is on, allow TCP and UDP 53 there too."
}

# The front door's wildcard for every hosted pen's public address (D-18):
# *.<GATE_DOMAIN>, kept by `registrar gate-cert` with the host's challenge DNS
# credential. A pen whose PUBLIC_HOST is under the gate domain uses it, but
# only once it exists: a missing file must never stop the front door loading.
GATE_TLS=/var/lib/hogman-gate/tls
gate_tls_line() {
  local host="$1" label
  [ -n "${GATE_DOMAIN:-}" ] && [[ "$host" == *".$GATE_DOMAIN" ]] || return 0
  label="${host%".$GATE_DOMAIN"}"
  [[ "$label" != *.* ]] || return 0   # the wildcard covers exactly one label
  [ -s "$GATE_TLS/gate.crt" ] && [ -s "$GATE_TLS/gate.key" ] \
    && printf '\ttls /gate-tls/gate.crt /gate-tls/gate.key'
  return 0
}

# Re-resolve host bind mounts ($CDNS_BIN and /run/challenge-dns) in the sign-up
# broker whenever challenge-dns is reinstalled or restarted.
restart_signup_broker() {
  [ -f "$SIGNUP/compose.yaml" ] || return 0
  if [ -n "$(docker ps -q --filter name=^/hogman-signup-broker-1$ 2>/dev/null)" ]; then
    (cd "$SIGNUP" && docker compose restart broker >&2) || docker restart hogman-signup-broker-1 >/dev/null
    info "sign-up broker restarted to refresh challenge-dns mounts"
  fi
}

# refresh-services: after an update, put this release's compiled challenge DNS
# server and gate-certificate keeper in place and restart them, but only the
# ones this host already runs and only when the binary changed. install.sh
# calls it, so a release reaches them like it reaches the pens.
cmd_refresh_services() {
  local arch
  case "$(uname -m)" in x86_64|amd64) arch=amd64 ;; aarch64|arm64) arch=arm64 ;; *) die "unsupported CPU $(uname -m)" ;; esac
  refresh_one() {  # refresh_one <installed path> <prebuilt path> <service>
    local dst="$1" src="$2" svc="$3"
    [ -x "$dst" ] && [ -f "/etc/systemd/system/$svc.service" ] || return 0
    [ -f "$src" ] || { info "$svc: no compiled copy in this release; left as is"; return 0; }
    if cmp -s "$src" "$dst"; then info "$svc: already current"; return 0; fi
    install -m 0755 "$src" "$dst.new" && mv -f "$dst.new" "$dst"
    systemctl restart "$svc.service"
    systemctl is-active --quiet "$svc.service" || die "$svc didn't come back: journalctl -u $svc"
    info "$svc: updated and restarted"
    if [ "$svc" = hogman-challenge-dns ]; then
      restart_signup_broker
    fi
  }
  refresh_one "$CDNS_BIN" "$SRC/prebuilt/challenge-dns/challenge-dns-linux-$arch" hogman-challenge-dns
  refresh_one /usr/local/bin/hogman-registrar "$SRC/prebuilt/registrar/registrar-linux-$arch" hogman-gate-cert
}

# dockerfile_images <file...>: print every external FROM image (skipping
# scratch and earlier stage names) from the given Dockerfiles.
dockerfile_images() {
  awk '
    FNR == 1 { split("", stages) }
    tolower($1) == "from" {
      i = 2
      while (i <= NF && substr($i, 1, 2) == "--") i++
      if (i > NF) next
      img = $i
      if (tolower(img) != "scratch" && !(tolower(img) in stages)) {
        print img
      }
      if ((i + 2) <= NF && tolower($(i + 1)) == "as") {
        stages[tolower($(i + 2))] = 1
      }
    }
  ' "$@"
}

# compose_images <file...>: print every external `image:` value (skipping
# locally-built hogman/* images) from the given Compose files.
compose_images() {
  awk '
    /^[[:space:]]*image:[[:space:]]*/ {
      line = $0
      sub(/^[[:space:]]*image:[[:space:]]*/, "", line)
      sub(/[[:space:]]*#.*$/, "", line)
      gsub(/^["'\'']|["'\'']$/, "", line)
      sub(/[[:space:]]+$/, "", line)
      if (line != "" && line !~ /^hogman\// && line !~ /\$/) {
        print line
      }
    }
  ' "$@"
}

# shipped_images [host|all]: print sorted unique external container images
# required to build and run pens (and the sign-up stack) offline on this host.
shipped_images() {
  local mode="${1:-host}" arch=""
  case "$(uname -m)" in x86_64|amd64) arch=amd64 ;; aarch64|arm64) arch=arm64 ;; esac
  local dfs=() cfs=()
  [ -f "$SRC/compose.yaml" ] && cfs+=("$SRC/compose.yaml")
  [ -f "$SRC/compose.front.yaml" ] && cfs+=("$SRC/compose.front.yaml")
  if [ "$mode" = all ]; then
    for f in "$SRC/registrar/Dockerfile.prebuilt" "$SRC/registrar/Dockerfile" \
             "$SRC/join/Dockerfile" \
             "$HOGMAN_HOME/signup-src/Dockerfile.prebuilt" "$HOGMAN_HOME/signup-src/Dockerfile" \
             "$SIGNUP/build/Dockerfile.prebuilt" "$SIGNUP/build/Dockerfile"; do
      [ -f "$f" ] && dfs+=("$f")
    done
  else
    if [ -n "$arch" ] && [ -f "$SRC/prebuilt/registrar/registrar-linux-$arch" ] && [ -f "$SRC/registrar/Dockerfile.prebuilt" ]; then
      dfs+=("$SRC/registrar/Dockerfile.prebuilt")
    elif [ -f "$SRC/registrar/Dockerfile" ]; then
      dfs+=("$SRC/registrar/Dockerfile")
    fi
    if [ ! -f "$SRC/prebuilt/join/SHA256SUMS" ] && [ -f "$SRC/join/Dockerfile" ]; then
      dfs+=("$SRC/join/Dockerfile")
    fi
    local sdir=""
    if [ -d "$HOGMAN_HOME/signup-src" ]; then sdir="$HOGMAN_HOME/signup-src"
    elif [ -d "$SIGNUP/build" ]; then sdir="$SIGNUP/build"
    fi
    if [ -n "$sdir" ]; then
      if [ -n "$arch" ] && [ -f "$SRC/prebuilt/signup/hogman-signup-linux-$arch" ] && [ -f "$sdir/Dockerfile.prebuilt" ]; then
        dfs+=("$sdir/Dockerfile.prebuilt")
      elif [ -f "$sdir/Dockerfile" ]; then
        dfs+=("$sdir/Dockerfile")
      fi
    fi
  fi
  {
    [ -n "${CADDY_IMAGE:-}" ] && printf '%s\n' "$CADDY_IMAGE"
    [ "${#cfs[@]}" -gt 0 ] && compose_images "${cfs[@]}"
    [ "${#dfs[@]}" -gt 0 ] && dockerfile_images "${dfs[@]}"
  } | sort -u
}

# pull-images [--list] [--all]: pre-pull every external base and runtime image
# referenced by the shipped Dockerfiles and Compose files, so the sign-up broker
# (which runs on an internal network with no internet) never needs to contact
# a container registry when provisioning a pen.
cmd_pull_images() {
  local mode="host" list_only=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --list) list_only=1; shift ;;
      --all)  mode="all"; shift ;;
      *) die "usage: hogman-host pull-images [--list] [--all]" ;;
    esac
  done
  local imgs
  imgs="$(shipped_images "$mode")"
  if [ "$list_only" = 1 ]; then
    [ -n "$imgs" ] && printf '%s\n' "$imgs"
    return 0
  fi
  [ -n "$imgs" ] || return 0
  command -v docker >/dev/null || die "Docker is not installed"
  local img pulled=0
  while IFS= read -r img; do
    [ -n "$img" ] || continue
    if docker image inspect "$img" >/dev/null 2>&1; then
      continue
    fi
    info "pulling $img"
    docker pull -q "$img" >&2 || die "could not pull $img"
    pulled=$((pulled + 1))
  done <<< "$imgs"
  if [ "$pulled" -eq 0 ]; then
    info "container images already cached"
  fi
}

# gate-cert-setup <gate-domain>: keep the *.<gate-domain> wildcard for the
# front door, e.g.  gate-cert-setup gate.hogman.network
GATE_TOKEN=/etc/hogman/gate-challenge-token
cmd_gate_cert_setup() {
  load_host
  local domain="${1:-}" arch
  valid_host "$domain" || die "usage: hogman-host gate-cert-setup <gate-domain>   (e.g. gate.hogman.network)"
  [ -x "$CDNS_BIN" ] || die "set up the challenge DNS server first: hogman-host challenge-dns-setup <public-ip>"
  case "$(uname -m)" in x86_64|amd64) arch=amd64 ;; aarch64|arm64) arch=arm64 ;; *) die "unsupported CPU $(uname -m)" ;; esac
  local bin="$SRC/prebuilt/registrar/registrar-linux-$arch"
  [ -f "$bin" ] || die "no compiled registrar in this release ($bin)"
  install -m 0755 "$bin" /usr/local/bin/hogman-registrar

  # The host credential: it may write only _acme-challenge.<gate-domain>.
  if [ ! -s "$GATE_TOKEN" ]; then
    local out tok
    out="$(cdns cred add host)" || die "could not make the host's challenge DNS credential: $out"
    tok="$(awk '/^token:/ {print $2}' <<<"$out")"; [ -n "$tok" ] || die "no token from challenge-dns"
    install -d -m 0700 /etc/hogman
    ( umask 077; printf '%s' "$tok" > "$GATE_TOKEN" )
  fi
  set_host_var GATE_DOMAIN "$domain"
  GATE_DOMAIN="$domain"
  # systemd needs a real account for User=: a bare uid with no passwd entry
  # fails with 217/USER. Same uid and group as the pens' registrars and the
  # front door's Caddy (H3), so they can read the files it writes.
  getent group "$PEN_GID" >/dev/null || groupadd --system --gid "$PEN_GID" hogman-pen
  getent passwd "$PEN_GID" >/dev/null || useradd --system --uid "$PEN_GID" --gid "$PEN_GID" \
    --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin hogman-pen
  local penuser; penuser="$(getent passwd "$PEN_GID" | cut -d: -f1)"
  local pengroup; pengroup="$(getent group "$PEN_GID" | cut -d: -f1)"
  install -d -m 0700 -o "$PEN_GID" -g "$PEN_GID" /var/lib/hogman-gate "$GATE_TLS" /var/lib/hogman-gate/acme
  # Mount the wildcard's folder into the front door now (this recreates it
  # once), so the first certificate only needs a reload, not a restart.
  write_front
  reload_front

  cat > /etc/systemd/system/hogman-gate-cert.service <<UNIT
[Unit]
Description=Hogman: the front door's *.$domain certificate
After=network-online.target hogman-challenge-dns.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/hogman-registrar gate-cert
Environment=GATE_HOST=*.$domain
Environment=GATE_TLS_DIR=$GATE_TLS
Environment=ACME_STORAGE_DIR=/var/lib/hogman-gate/acme
Environment=CHALLENGE_DNS_URL=unix:///run/hogman-acme/api.sock
Environment=CHALLENGE_DNS_TOKEN_FILE=%d/gate-token
Environment=ACME_CA_URL=${GATE_ACME_CA_URL:-https://acme-v02.api.letsencrypt.org/directory}
LoadCredential=gate-token:$GATE_TOKEN
# The front door's Caddy runs as $PEN_GID too, so it can read the key.
User=$penuser
Group=$pengroup
StateDirectory=hogman-gate hogman-gate/tls hogman-gate/acme
StateDirectoryMode=0700
ReadWritePaths=/run/hogman-acme
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
InaccessiblePaths=-$HOGMAN_HOME -/etc/hogman -/var/backups -/var/lib/challenge-dns
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
UNIT
  # When the certificate changes, rewrite the front door's routes (which turn
  # on the wildcard once it exists) and reload it.
  cat > /etc/systemd/system/hogman-gate-reload.path <<UNIT
[Unit]
Description=Hogman: reload the front door when its wildcard changes
[Path]
PathChanged=$GATE_TLS/gate.crt
[Install]
WantedBy=multi-user.target
UNIT
  cat > /etc/systemd/system/hogman-gate-reload.service <<UNIT
[Unit]
Description=Hogman: reload the front door with its new wildcard
[Service]
Type=oneshot
Environment=HOGMAN_HOME=$HOGMAN_HOME
ExecStart=/usr/local/bin/hogman-host routes
UNIT
  systemctl daemon-reload
  systemctl enable --now hogman-gate-reload.path >/dev/null
  systemctl enable hogman-gate-cert.service >/dev/null

  # Only start asking for the certificate once the challenge name is really
  # delegated to us: failed attempts count against Let's Encrypt's limits.
  local ns
  ns="$(curl -fsS -m 10 -H 'accept: application/dns-json' \
        "https://cloudflare-dns.com/dns-query?name=_acme-challenge.$domain&type=NS" 2>/dev/null \
        | grep -o '"data":"[^"]*"' | head -1 | cut -d'"' -f4)"
  if [ -n "$ns" ]; then
    systemctl restart hogman-gate-cert.service
    info "Getting *.$domain (delegated to $ns). Watch: journalctl -u hogman-gate-cert -f"
  else
    info "Installed, not started: _acme-challenge.$domain isn't delegated yet."
    info "Add an NS record for _acme-challenge.$domain -> ns1.<your domain> in DNS, then: systemctl start hogman-gate-cert"
  fi
}

case "${1:-}" in
  init)    shift; cmd_init "$@" ;;
  gate-cert-setup) shift; cmd_gate_cert_setup "$@" ;;
  challenge-dns-setup) shift; cmd_challenge_dns_setup "$@" ;;
  fallback-contact) shift; cmd_fallback_contact "$@" ;;
  refresh-services) shift; load_host; cmd_refresh_services "$@" ;;
  pull-images) shift; cmd_pull_images "$@" ;;
  challenge-dns) shift; load_host; [ -x "$CDNS_BIN" ] || die "not set up: hogman-host challenge-dns-setup"; CDNS_ADMIN_SOCK="$CDNS_ADMIN" exec "$CDNS_BIN" "$@" ;;
  pens-zone) shift; cmd_pens_zone "$@" ;;
  name-free) shift; load_host; [[ "${1:-}" =~ $HOSTED_RE ]] || die "usage: hogman-host name-free <pen>"; name_free "$1"; exit $? ;;
  waitlist) shift; cmd_waitlist "$@" ;;
  signup-mail) shift; cmd_signup_mail "$@" ;;
  signup-notify) shift; cmd_signup_notify "$@" ;;
  signup-stripe) shift; cmd_signup_stripe "$@" ;;
  signup-cloudflare) shift; cmd_signup_cloudflare "$@" ;;
  signup-turnstile) shift; cmd_signup_turnstile "$@" ;;
  signup-work-host) shift; cmd_signup_work_host "$@" ;;
  capacity) cmd_capacity ;;
  provision) shift; cmd_provision "$@" ;;
  signup-setup) shift; cmd_signup_setup "$@" ;;
  signup-code) shift; cmd_signup_code "$@" ;;
  add)     shift; cmd_add "$@" ;;
  list)    cmd_list ;;
  pen)     shift; cmd_pen "$@" ;;
  theme)   shift; cmd_theme "$@" ;;
  plan)    shift; cmd_plan "$@" ;;
  upgrade) shift; cmd_upgrade "$@" ;;
  routes)  load_host; write_front; reload_front; info "routes rewritten" ;;
  remove)  shift; cmd_remove "$@" ;;
  sleep)   shift; cmd_sleep "$@" ;;
  wake)    shift; cmd_wake "$@" ;;
  purge)   shift; cmd_purge "$@" ;;
  lifecycle) shift; cmd_lifecycle "$@" ;;
