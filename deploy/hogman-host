UNIT
  systemctl daemon-reload
  systemctl enable --now hogman-lifecycle.timer >/dev/null
  info "Daily lifecycle sweep on (04:15 UTC)"
}

OPS_SNAPSHOT_BIN=/usr/local/lib/hogman/ops-snapshot
OPS_SNAPSHOT_DIR=/run/hogman-ops

